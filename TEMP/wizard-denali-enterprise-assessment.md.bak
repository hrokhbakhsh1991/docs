```mermaid
flowchart TB
  subgraph platform ["Platform (خوب جدا شده)"]
    SDK["workspace-sdk contract"]
    PC["platform-core engine"]
    Host["WorkspaceWizardHost"]
    Orch["WorkspaceCreateTourWizardClient"]
  end

  subgraph denali_path ["Denali (مسیر کامل)"]
    Dpkg["packages/workspaces/denali"]
    Dui["apps/web/wizard/denali (88 فایل)"]
    Dapi["apps/api/denali-finance"]
  end

  subgraph urban_path ["Urban/Starter (مسیر ساده)"]
    Upkg["packages/workspaces/urban"]
    Orch
  end

  SDK --> Host
  SDK --> PC
  Host --> Dui
  Host --> Orch
  Orch --> Upkg
  Dpkg --> Dui
  Dapi --> Dpkg
```

