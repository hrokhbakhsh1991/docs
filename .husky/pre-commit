#!/usr/bin/env sh
# Zero-tolerance pre-commit — do not use git commit --no-verify.
set -eu

if [ "${HUSKY:-1}" = "0" ]; then
  echo "error: HUSKY=0 is not allowed — hooks cannot be disabled for this repository." >&2
  exit 1
fi

if [ "${SKIP_HOOKS:-}" != "" ] || [ "${SKIP_HOOK:-}" != "" ]; then
  echo "error: SKIP_HOOKS/SKIP_HOOK is not allowed — hooks cannot be bypassed." >&2
  exit 1
fi

if bash scripts/phase-hooks-suspended.sh; then
  if [ -f docs/phase-9/appendices/PHASE-9-HOOKS-SUSPENSION.yaml ] \
    && grep -Eq '^[[:space:]]*active:[[:space:]]*true' docs/phase-9/appendices/PHASE-9-HOOKS-SUSPENSION.yaml; then
    echo "pre-commit: SUSPENDED for Phase 9 — docs/phase-9/appendices/PHASE-9-HOOKS-SUSPENSION.yaml"
    echo "pre-commit: re-enable at subphase 9.8 — delete marker + phase-9:guard + test:full + phase-9:gate"
  else
    echo "pre-commit: SUSPENDED for Phase 8 — docs/phase-8/appendices/PHASE-8-HOOKS-SUSPENSION.yaml"
    echo "pre-commit: re-enable at subphase 8.5 — delete marker + pre-commit:fast + test:full + phase-8:gate"
  fi
  exit 0
fi

bash scripts/pre-commit-fast.sh
