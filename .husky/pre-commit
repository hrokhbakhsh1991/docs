#!/usr/bin/env sh
# Zero-tolerance pre-commit — do not use git commit --no-verify.
set -eu

if [ "${HUSKY:-1}" = "0" ]; then
  echo "error: HUSKY=0 is not allowed — hooks cannot be disabled for this repository." >&2
  exit 1
fi

if [ "${SKIP_HOOKS:-}" != "" ] || [ "${SKIP_HOOK:-}" != "" ]; then
  echo "error: SKIP_HOOKS/SKIP_HOOK is not allowed — hooks cannot be bypassed." >&2
  exit 1
fi

if bash scripts/phase-8-hooks-suspended.sh; then
  echo "pre-commit: SUSPENDED for Phase 8 (active marker) — see docs/phase-8/appendices/PHASE-8-HOOKS-SUSPENSION.yaml"
  echo "pre-commit: re-enable at subphase 8.5 — delete marker + run pre-commit:fast + test:full + phase-8:gate"
  exit 0
fi

bash scripts/pre-commit-fast.sh
