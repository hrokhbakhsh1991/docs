{
  "name": "@app-tour/workspace-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace plugin contract — platform-generic",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ingress": {
      "types": "./dist/ingress/index.d.ts",
      "default": "./dist/ingress/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./canonical": {
      "types": "./dist/canonical/index.d.ts",
      "default": "./dist/canonical/index.js"
    },
    "./plugin-types": {
      "types": "./dist/plugin-types/index.d.ts",
      "default": "./dist/plugin-types/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./auth/casl": {
      "types": "./dist/auth/casl/index.d.ts",
      "default": "./dist/auth/casl/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    },
    "./metadata/workspace-definition-payload": {
      "types": "./dist/metadata/workspace-definition-payload.d.ts",
      "default": "./dist/metadata/workspace-definition-payload.js"
    },
    "./metadata/allowed-platform-renderer-ids": {
      "types": "./dist/metadata/allowed-platform-renderer-ids.d.ts",
      "default": "./dist/metadata/allowed-platform-renderer-ids.js"
    },
    "./metadata/checksum": {
      "types": "./dist/metadata/workspace-definition-payload-checksum.d.ts",
      "default": "./dist/metadata/workspace-definition-payload-checksum.js"
    },
    "./wizard": {
      "types": "./dist/wizard/index.d.ts",
      "default": "./dist/wizard/index.js"
    },
    "./equipment": {
      "types": "./dist/equipment/index.d.ts",
      "default": "./dist/equipment/index.js"
    },
    "./difficulty-fitness": {
      "types": "./dist/difficulty-fitness/index.d.ts",
      "default": "./dist/difficulty-fitness/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./itinerary": {
      "types": "./dist/itinerary/index.d.ts",
      "default": "./dist/itinerary/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "default": "./dist/pricing/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./workspace-registry": {
      "types": "./dist/workspace-registry/index.d.ts",
      "default": "./dist/workspace-registry/index.js"
    },
    "./equipment": {
      "types": "./dist/equipment/index.d.ts",
      "default": "./dist/equipment/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../catalog-registration-auth run build && pnpm --dir ../tour-core run build && rm -rf dist && tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "validate:manifests": "node --import tsx scripts/validate-manifests.ts",
    "test": "NODE_ENV=test node --import ./test/register-server-only-stub.mjs --import tsx --test \"test/**/*.spec.ts\"",
    "test:phase-0": "pnpm run build && NODE_ENV=test LEGACY_IMPORT_SCAN_SCOPE=foundation node --import ./test/register-server-only-stub.mjs --import tsx --test test/phase-0.contract.spec.ts",
    "test:invariants": "NODE_ENV=test node --import ./test/register-server-only-stub.mjs --import tsx --test test/invariant-manifest.contract.spec.ts",
    "test:contract:foundation": "pnpm run test:phase-0",
    "test:contract:monorepo": "NODE_ENV=test node --import ./test/register-server-only-stub.mjs --import tsx --test test/legacy-import.monorepo.contract.spec.ts",
    "test:contract": "pnpm run test:phase-0"
  },
  "peerDependencies": {
    "@casl/ability": "^6.7.3"
  },
  "peerDependenciesMeta": {
    "@casl/ability": {
      "optional": true
    }
  },
  "dependencies": {
    "@app-tour/tour-core": "workspace:*",
    "@app-tour/catalog-registration-auth": "workspace:*",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@app-tour/workspace-cert-club": "workspace:*",
    "@app-tour/workspace-denali": "workspace:*",
    "@casl/ability": "^6.7.3",
    "@app-tour/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
