{
  "name": "@app-tour/tenant-kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Tenant host resolution and RLS session helpers — Phase 4",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host-only": {
      "types": "./dist/host-only.d.ts",
      "default": "./dist/host-only.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test \"test/**/*.spec.ts\"",
    "test:phase-4": "pnpm run build && NODE_ENV=test node --import tsx --test test/phase-4.contract.spec.ts"
  },
  "dependencies": {
    "@app-tour/workspace-sdk": "workspace:*"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
