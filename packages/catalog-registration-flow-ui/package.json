{
  "name": "@app-tour/catalog-registration-flow-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared catalog registration auth flow steps (phone, OTP, profile) for guest portal",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test \"test/**/*.spec.ts\""
  },
  "dependencies": {
    "@app-tour/catalog-registration-auth": "workspace:*",
    "@app-tour/ui-primitives": "workspace:*",
    "@app-tour/workspace-sdk": "workspace:*"
  },
  "peerDependencies": {
    "next-intl": "^4.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "next-intl": "^4.3.4",
    "react": "^19.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
