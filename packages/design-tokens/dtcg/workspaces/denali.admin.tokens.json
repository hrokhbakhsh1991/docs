{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "workspaceId": "denali",
  "blocks": [
    {
      "scopeSelector": "body[data-workspace-plugin=\"denali\"]",
      "denali": {
        "forest-700": { "$type": "color", "$value": "#0f5c4a" },
        "forest-600": { "$type": "color", "$value": "#0f766e" },
        "forest-500": { "$type": "color", "$value": "#14b8a6" },
        "alpine-600": { "$type": "color", "$value": "#31547e" },
        "bark-600": { "$type": "color", "$value": "#765832" },
        "mist-50": { "$type": "color", "$value": "#f4f7f4" },
        "mist-100": { "$type": "color", "$value": "#e8efe8" },
        "shadow-card": {
          "$type": "shadow",
          "$value": "0 1px 2px rgb(15 23 42 / 0.04), 0 4px 12px rgb(15 23 42 / 0.06)"
        },
        "shadow-card-hover": {
          "$type": "shadow",
          "$value": "0 2px 4px rgb(15 23 42 / 0.06), 0 8px 20px rgb(15 23 42 / 0.08)"
        }
      },
      "color": {
        "primary": { "$type": "color", "$value": "{denali.forest-600}" },
        "primary-hover": { "$type": "color", "$value": "{denali.forest-700}" },
        "primary-fg": { "$type": "color", "$value": "#ffffff" },
        "bg-page": { "$type": "color", "$value": "{denali.mist-50}" },
        "bg-surface": { "$type": "color", "$value": "#ffffff" },
        "bg-muted": { "$type": "color", "$value": "{denali.mist-100}" },
        "text-primary": { "$type": "color", "$value": "#1a1f26" },
        "text-secondary": { "$type": "color", "$value": "#4a5244" },
        "text-muted": { "$type": "color", "$value": "#6f7768" },
        "text-link": { "$type": "color", "$value": "{denali.forest-600}" },
        "border-default": { "$type": "color", "$value": "#dce5dc" },
        "border-subtle": { "$type": "color", "$value": "#e8efe8" },
        "info": { "$type": "color", "$value": "{denali.alpine-600}" },
        "info-bg": { "$type": "color", "$value": "#e8f0f8" },
        "success": { "$type": "color", "$value": "#166534" },
        "success-bg": { "$type": "color", "$value": "#dcfce7" },
        "warning": { "$type": "color", "$value": "#b45309" },
        "warning-bg": { "$type": "color", "$value": "#fff7ed" }
      },
      "flat": {
        "focus-ring-color": { "$type": "color", "$value": "rgb(15 118 110 / 0.35)" },
        "focus-ring-offset": { "$type": "color", "$value": "#ffffff" },
        "radius": { "$type": "dimension", "$value": "0.625rem" },
        "background": { "$type": "color", "$value": "{color.bg-page}" },
        "foreground": { "$type": "color", "$value": "{color.text-primary}" },
        "card": { "$type": "color", "$value": "{color.bg-surface}" },
        "card-foreground": { "$type": "color", "$value": "{color.text-primary}" },
        "popover": { "$type": "color", "$value": "{color.bg-surface}" },
        "popover-foreground": { "$type": "color", "$value": "{color.text-primary}" },
        "primary": { "$type": "color", "$value": "{color.primary}" },
        "primary-foreground": { "$type": "color", "$value": "{color.primary-fg}" },
        "secondary": { "$type": "color", "$value": "{color.bg-muted}" },
        "secondary-foreground": { "$type": "color", "$value": "{color.text-primary}" },
        "muted": { "$type": "color", "$value": "{color.bg-muted}" },
        "muted-foreground": { "$type": "color", "$value": "{color.text-muted}" },
        "accent": { "$type": "color", "$value": "{denali.mist-100}" },
        "accent-foreground": { "$type": "color", "$value": "{denali.forest-700}" },
        "destructive": { "$type": "color", "$value": "#dc2626" },
        "destructive-foreground": { "$type": "color", "$value": "#ffffff" },
        "border": { "$type": "color", "$value": "{color.border-default}" },
        "input": { "$type": "color", "$value": "{color.border-subtle}" },
        "ring": { "$type": "color", "$value": "{flat.focus-ring-color}" },
        "ring-offset-background": { "$type": "color", "$value": "{color.bg-surface}" },
        "sidebar": { "$type": "color", "$value": "#ffffff" },
        "sidebar-foreground": { "$type": "color", "$value": "#1a1f26" },
        "sidebar-primary": { "$type": "color", "$value": "{denali.forest-600}" },
        "sidebar-primary-foreground": { "$type": "color", "$value": "#ffffff" },
        "sidebar-accent": { "$type": "color", "$value": "{denali.mist-100}" },
        "sidebar-accent-foreground": { "$type": "color", "$value": "{denali.forest-700}" },
        "sidebar-border": { "$type": "color", "$value": "#dce5dc" },
        "shell-sidebar-width": { "$type": "dimension", "$value": "16.5rem" },
        "shadow-card": { "$type": "shadow", "$value": "{denali.shadow-card}" }
      }
    },
    {
      "scopeSelector": "html.dark:has(body[data-workspace-plugin=\"denali\"]), .dark body[data-workspace-plugin=\"denali\"], body[data-workspace-plugin=\"denali\"] .theme-dark",
      "color": {
        "primary": { "$type": "color", "$value": "#5eead4" },
        "primary-hover": { "$type": "color", "$value": "#99f6e4" },
        "primary-fg": { "$type": "color", "$value": "#0f140f" },
        "bg-page": { "$type": "color", "$value": "#161b13" },
        "bg-surface": { "$type": "color", "$value": "#1f2620" },
        "bg-muted": { "$type": "color", "$value": "#242c24" },
        "text-primary": { "$type": "color", "$value": "#e8ebe6" },
        "text-secondary": { "$type": "color", "$value": "#b0b8aa" },
        "text-muted": { "$type": "color", "$value": "#7d8778" },
        "text-link": { "$type": "color", "$value": "#5eead4" },
        "border-default": { "$type": "color", "$value": "#2f382f" },
        "border-subtle": { "$type": "color", "$value": "#1f261f" }
      },
      "flat": {
        "focus-ring-color": { "$type": "color", "$value": "rgb(94 234 212 / 0.4)" },
        "focus-ring-offset": { "$type": "color", "$value": "#1f2620" },
        "background": { "$type": "color", "$value": "{color.bg-page}" },
        "foreground": { "$type": "color", "$value": "{color.text-primary}" },
        "card": { "$type": "color", "$value": "{color.bg-surface}" },
        "card-foreground": { "$type": "color", "$value": "{color.text-primary}" },
        "primary": { "$type": "color", "$value": "{color.primary}" },
        "primary-foreground": { "$type": "color", "$value": "{color.primary-fg}" },
        "secondary": { "$type": "color", "$value": "{color.bg-muted}" },
        "secondary-foreground": { "$type": "color", "$value": "{color.text-primary}" },
        "muted": { "$type": "color", "$value": "{color.bg-muted}" },
        "muted-foreground": { "$type": "color", "$value": "{color.text-muted}" },
        "accent": { "$type": "color", "$value": "#242c24" },
        "accent-foreground": { "$type": "color", "$value": "#5eead4" },
        "border": { "$type": "color", "$value": "{color.border-default}" },
        "input": { "$type": "color", "$value": "{color.border-subtle}" },
        "ring": { "$type": "color", "$value": "{flat.focus-ring-color}" },
        "sidebar": { "$type": "color", "$value": "#1a211a" },
        "sidebar-foreground": { "$type": "color", "$value": "#e8ebe6" },
        "sidebar-primary": { "$type": "color", "$value": "#5eead4" },
        "sidebar-primary-foreground": { "$type": "color", "$value": "#0f140f" },
        "sidebar-accent": { "$type": "color", "$value": "#242c24" },
        "sidebar-accent-foreground": { "$type": "color", "$value": "#5eead4" },
        "sidebar-border": { "$type": "color", "$value": "#2f382f" },
        "shell-sidebar-width": { "$type": "dimension", "$value": "16.5rem" }
      }
    }
  ]
}
