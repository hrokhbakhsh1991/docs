{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "workspaceId": "denali",
  "scopeSelector": "body[data-app-surface=\"marketing\"][data-workspace-plugin=\"denali\"]",
  "denali": {
    "forest-700": {
      "$type": "color",
      "$value": "#047857"
    },
    "forest-600": {
      "$type": "color",
      "$value": "#059669"
    },
    "forest-500": {
      "$type": "color",
      "$value": "#14b8a6"
    },
    "alpine-600": {
      "$type": "color",
      "$value": "#31547e"
    },
    "bark-600": {
      "$type": "color",
      "$value": "#765832"
    },
    "mist-50": {
      "$type": "color",
      "$value": "#f4f7f4"
    },
    "mist-100": {
      "$type": "color",
      "$value": "#e8efe8"
    },
    "shadow-card": {
      "$type": "shadow",
      "$value": "0 1px 2px rgb(15 23 42 / 0.04), 0 4px 12px rgb(15 23 42 / 0.06)"
    },
    "shadow-card-hover": {
      "$type": "shadow",
      "$value": "0 2px 4px rgb(15 23 42 / 0.06), 0 8px 20px rgb(15 23 42 / 0.08)"
    }
  },
  "color": {
    "primary": {
      "$type": "color",
      "$value": "{denali.forest-600}"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "{denali.forest-700}"
    },
    "primary-fg": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "bg-page": {
      "$type": "color",
      "$value": "{denali.mist-50}"
    },
    "bg-surface": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "bg-muted": {
      "$type": "color",
      "$value": "{denali.mist-100}"
    },
    "text-primary": {
      "$type": "color",
      "$value": "#1a1f26"
    },
    "text-secondary": {
      "$type": "color",
      "$value": "#4a5244"
    },
    "text-muted": {
      "$type": "color",
      "$value": "#6f7768"
    },
    "text-link": {
      "$type": "color",
      "$value": "{denali.forest-600}"
    },
    "border-default": {
      "$type": "color",
      "$value": "#dce5dc"
    },
    "border-subtle": {
      "$type": "color",
      "$value": "#e8efe8"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "rgb(5 150 105 / 0.35)"
    },
    "info": {
      "$type": "color",
      "$value": "{denali.alpine-600}"
    },
    "info-bg": {
      "$type": "color",
      "$value": "#e8f0f8"
    },
    "success": {
      "$type": "color",
      "$value": "#166534"
    },
    "success-bg": {
      "$type": "color",
      "$value": "#dcfce7"
    },
    "warning": {
      "$type": "color",
      "$value": "#b45309"
    },
    "warning-bg": {
      "$type": "color",
      "$value": "#fff7ed"
    }
  },
  "flat": {
    "destructive": {
      "$type": "color",
      "$value": "#dc2626"
    },
    "destructive-foreground": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "radius": {
      "$type": "dimension",
      "$value": "0.625rem"
    }
  },
  "mkt": {
    "on-overlay": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text/icons on dark marketing overlays"
    },
    "overlay-icon": {
      "$type": "color",
      "$value": "#fbbf24",
      "$description": "Hero overlay brand icon accent"
    },
    "hero-ink": {
      "$type": "color",
      "$value": "#0b1220",
      "$description": "Dark hero section ink"
    },
    "mask-ink": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Mask gradient ink (technical)"
    },
    "accent-mid": {
      "$type": "color",
      "$value": "#b45309",
      "$description": "Accent gradient mid-stop"
    },
    "accent-deep": {
      "$type": "color",
      "$value": "#92400e",
      "$description": "Accent gradient deep-stop"
    },
    "destructive": {
      "$type": "color",
      "$value": "#dc2626",
      "$description": "Marketing destructive surface"
    },
    "destructive-strong": {
      "$type": "color",
      "$value": "#b91c1c",
      "$description": "Marketing destructive emphasis"
    }
  }
}
