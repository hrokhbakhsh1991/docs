{
  "name": "@app-tour/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Platform design tokens — CSS custom properties; main entry exports SemanticCssVariableName and platform token unions (see ./tokens)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "tokens.meta.json"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./guest-shell.css": "./dist/guest-shell.css",
    "./portal-bootstrap.css": "./dist/portal-bootstrap.css",
    "./marketing-bootstrap.css": "./dist/marketing-bootstrap.css",
    "./admin-bootstrap.css": "./dist/admin-bootstrap.css",
    "./guest-body-reset.css": "./dist/guest-body-reset.css",
    "./platform-infra-shell.css": "./dist/platform-infra-shell.css",
    "./operator-admin-appearance.css": "./dist/operator-admin-appearance.css",
    "./fallback-guest-marketing-shell.css": "./dist/fallback-guest-marketing-shell.css",
    "./shell-bridge.css": "./dist/shell-bridge.css",
    "./operator-shell-structure.css": "./dist/operator-shell-structure.css",
    "./semantic": {
      "types": "./dist/generated/semantic-tokens.d.ts",
      "default": "./dist/generated/semantic-tokens.js"
    },
    "./tokens": {
      "types": "./dist/generated/tokens.d.ts",
      "default": "./dist/generated/tokens.js"
    },
    "./tokens.meta.json": "./tokens.meta.json"
  },
  "scripts": {
    "build": "node ./scripts/generate-tokens.mjs && node ./scripts/build.mjs && tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/tokens-meta.contract.spec.mjs test/shell-bridge-decomposition.spec.mjs test/bootstrap-surface-parity.spec.mjs test/dtcg-light-generation.spec.mjs test/dtcg-dark-generation.spec.mjs"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "typescript": "5.9.3"
  }
}
