{
  "name": "@app-tour/workspace-denali",
  "version": "0.1.0",
  "private": true,
  "description": "Denali workspace plugin — registry, rules, composites, finance hooks (Phase 6)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/denali.plugin.d.ts",
      "default": "./dist/denali.plugin.js"
    },
    "./draft": {
      "types": "./dist/draft/index.d.ts",
      "default": "./dist/draft/index.js"
    },
    "./acl": {
      "types": "./dist/acl/migrateDenaliCanonical.d.ts",
      "default": "./dist/acl/migrateDenaliCanonical.js"
    },
    "./schemas/file-asset": {
      "types": "./dist/schemas/denaliFileAssetSchema.d.ts",
      "default": "./dist/schemas/denaliFileAssetSchema.js"
    },
    "./settings/theme-compatible-categories": {
      "types": "./dist/settings/theme-compatible-categories.d.ts",
      "default": "./dist/settings/theme-compatible-categories.js"
    },
    "./settings/equipment-compatible-categories": {
      "types": "./dist/settings/equipment-compatible-categories.d.ts",
      "default": "./dist/settings/equipment-compatible-categories.js"
    },
    "./settings/equipment-compatible-themes": {
      "types": "./dist/settings/equipment-compatible-themes.d.ts",
      "default": "./dist/settings/equipment-compatible-themes.js"
    },
    "./wizard/validation": {
      "types": "./dist/wizard/denali-wizard-validation.d.ts",
      "default": "./dist/wizard/denali-wizard-validation.js"
    },
    "./wizard/submit": {
      "types": "./dist/wizard/denali-wizard-submit-payload.d.ts",
      "default": "./dist/wizard/denali-wizard-submit-payload.js"
    },
    "./wizard/template-invariants": {
      "types": "./dist/wizard/ensure-tour-kind-template-field.d.ts",
      "default": "./dist/wizard/ensure-tour-kind-template-field.js"
    },
    "./clone/hydration": {
      "types": "./dist/clone/denali-tour-clone-hydration.d.ts",
      "default": "./dist/clone/denali-tour-clone-hydration.js"
    },
    "./edit": {
      "types": "./dist/edit/index.d.ts",
      "default": "./dist/edit/index.js"
    },
    "./tours": {
      "types": "./dist/tours/index.d.ts",
      "default": "./dist/tours/index.js"
    },
    "./photos": {
      "types": "./dist/photos/index.d.ts",
      "default": "./dist/photos/index.js"
    },
    "./wizard/host-hooks": {
      "types": "./dist/wizard/denali-wizard-host-hooks.d.ts",
      "default": "./dist/wizard/denali-wizard-host-hooks.js"
    },
    "./wizard/contextual": {
      "types": "./dist/wizard/contextual.d.ts",
      "default": "./dist/wizard/contextual.js"
    },
    "./wizard/canonical-form-sync": {
      "types": "./dist/wizard/denali-canonical-form-sync.d.ts",
      "default": "./dist/wizard/denali-canonical-form-sync.js"
    },
    "./program/itinerary": {
      "types": "./dist/schemas/denaliItineraryDaySchema.d.ts",
      "default": "./dist/schemas/denaliItineraryDaySchema.js"
    },
    "./wizard/resolve-initial-step-index": {
      "types": "./dist/wizard/resolve-initial-step-index.d.ts",
      "default": "./dist/wizard/resolve-initial-step-index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./http/routes": {
      "types": "./dist/http/routes.d.ts",
      "default": "./dist/http/routes.js"
    },
    "./theme/tokens.css": "./theme/tokens.css",
    "./theme/denali-admin.css": "./theme/denali-admin.css",
    "./theme/admin-skin.css": "./theme/admin-skin.css",
    "./messages/fa/wizard.json": "./messages/fa/wizard.json",
    "./messages/en/wizard.json": "./messages/en/wizard.json"
  },
  "files": [
    "dist",
    "messages",
    "theme/tokens.css",
    "theme/denali-admin.css",
    "theme/admin-skin.css",
    "theme/interactions.css",
    "theme/animations.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "denali:codegen": "node --import tsx ./scripts/denali-codegen.mjs",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test \"test/**/*.spec.ts\""
  },
  "dependencies": {
    "@app-tour/design-tokens": "workspace:*",
    "@app-tour/draft-engine": "workspace:*",
    "@app-tour/platform-core": "workspace:*",
    "@app-tour/workspace-sdk": "workspace:*",
    "minio": "^8.0.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
