    },
    "serviceDecorator": {
      "hostModule": "./case/wrap-finance-service-case-shadow",
      "export": "wrapFinanceServiceWithCaseShadow"
    },
    "eventReaction": {
      "module": "./finance",
      "export": "DenaliTourCreatedFinanceReactionAdapter",
      "requiresHostIo": true
    },
    "opsManifest": {
      "module": "./finance/manifest",
      "defaultExport": "DEFAULT_FINANCE_OPS_MANIFEST",
      "resolveFromThemeExport": "resolveFinanceOpsManifestFromTheme"
    },
    "chartOfAccounts": {
