      "export": "LEDGER_ACCOUNTS"
    },
    "registrationObligation": {
      "module": "./finance",
      "export": "resolveDenaliRegistrationObligationMinor"
    },
    "registrationObligationGross": {
      "module": "./finance",
      "export": "resolveDenaliRegistrationGrossObligationMinor"
    },
    "paymentCollection": {
      "module": "./finance",
      "export": "resolveDenaliPaymentCollectionMode"
    }
  },
  "workspaceWallet": {
    "supported": true,
    "capabilityRevision": 1,
    "defaultModuleEnabledWhenUnset": false,
