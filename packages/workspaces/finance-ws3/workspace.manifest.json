{
  "id": "finance-ws3",
  "version": 1,
  "package": "@app-tour/workspace-finance-ws3",
  "workspaceTypes": [
    "finance-ws3"
  ],
  "plugin": {
    "entry": "./plugin",
    "export": "getFinanceWs3WorkspacePlugin"
  },
  "tourWrite": {
    "module": "./tours",
    "workspaceTypeExport": "FINANCE_WS3_WORKSPACE_TYPE",
    "mergeExport": "mergeFinanceWs3CanonicalPatchData",
    "publishGateExport": "financeWs3TourPatchRequiresOwner",
    "publishSurfaceExport": "FINANCE_WS3_TOUR_PUBLISH_FIELDS_OWNER_SURFACE"
  },
  "workspaceFinance": {
    "supported": false,
    "ledgerPolicy": {
      "module": "./finance",
      "export": "FinanceWs3LedgerPolicyAdapter"
    },
    "receiptDefaults": {
      "module": "./finance",
      "export": "FinanceWs3ReceiptDefaultsAdapter"
    },
    "chartOfAccounts": {
      "module": "./finance",
      "export": "FINANCE_WS3_LEDGER_ACCOUNTS"
    },
    "registryOnly": true
  }
}
