{
  "name": "@app-tour/workspace-urban",
  "version": "0.1.0",
  "private": true,
  "description": "Urban workspace plugin — starter-plus genericity proof (Phase 7.1)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/urban.plugin.d.ts",
      "default": "./dist/urban.plugin.js"
    },
    "./host/catalog-registration-flow": {
      "types": "./dist/catalog/registration-flow/index.d.ts",
      "default": "./dist/catalog/registration-flow/index.js"
    },
    "./host/catalog-registration-flow/react": {
      "types": "./dist/catalog/registration-flow/react.d.ts",
      "default": "./dist/catalog/registration-flow/react.js"
    },
    "./host/http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./host/http/routes": {
      "types": "./dist/http/routes.d.ts",
      "default": "./dist/http/routes.js"
    },
    "./host/tours": {
      "types": "./dist/tours/index.d.ts",
      "default": "./dist/tours/index.js"
    },
    "./host/auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./host/catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./host/exposure": {
      "types": "./dist/exposure/index.d.ts",
      "default": "./dist/exposure/index.js"
    },
    "./host/smoke/phase-7-urban-smoke-tenant": {
      "types": "./dist/smoke/phase-7-urban-smoke-tenant.d.ts",
      "default": "./dist/smoke/phase-7-urban-smoke-tenant.js"
    },
    "./settings/urbanMinimalWizardTemplate": {
      "types": "./dist/settings/urbanMinimalWizardTemplate.d.ts",
      "default": "./dist/settings/urbanMinimalWizardTemplate.js"
    },
    "./theme/tokens.css": "./theme/tokens.css",
    "./theme/urban-marketing.css": "./theme/urban-marketing.css",
    "./theme/urban-portal.css": "./theme/urban-portal.css",
    "./host/messages/fa/wizard.json": "./messages/fa/wizard.json",
    "./host/messages/en/wizard.json": "./messages/en/wizard.json"
  },
  "files": [
    "dist",
    "theme/tokens.css",
    "theme/urban-marketing.css",
    "theme/urban-portal.css",
    "theme/marketing",
    "design-language",
    "messages"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.flow.json",
    "lint": "tsc --noEmit",
    "test": "node ../../../scripts/verify-phase-7-genericity-proof-rev.mjs && NODE_ENV=test node --import tsx --test \"test/**/*.spec.ts\""
  },
  "dependencies": {
    "@app-tour/catalog-intake-ui": "workspace:*",
    "@app-tour/catalog-registration-auth": "workspace:*",
    "@app-tour/design-tokens": "workspace:*",
    "@app-tour/platform-core": "workspace:*",
    "@app-tour/tenant-kernel": "workspace:*",
    "@app-tour/ui-primitives": "workspace:*",
    "@app-tour/workspace-sdk": "workspace:*",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "next-intl": "^4.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
