{
  "name": "@app-tour/workspace-finance-ws5",
  "version": "0.1.0",
  "private": true,
  "description": "Finance-ws5 reusable consumer proof — package + manifest + codegen (Phase 2.3.2)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./finance": {
      "types": "./dist/finance/index.d.ts",
      "default": "./dist/finance/index.js"
    },
    "./host/finance": {
      "types": "./dist/finance/index.d.ts",
      "default": "./dist/finance/index.js"
    },
    "./host/finance/manifest": {
      "types": "./dist/finance/finance-ops-manifest.d.ts",
      "default": "./dist/finance/finance-ops-manifest.js"
    },
    "./host/tours": {
      "types": "./dist/tours/index.d.ts",
      "default": "./dist/tours/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test \"test/**/*.spec.ts\""
  },
  "dependencies": {
    "@app-tour/finance-http-contracts": "workspace:*",
    "@app-tour/workspace-sdk": "workspace:*"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
