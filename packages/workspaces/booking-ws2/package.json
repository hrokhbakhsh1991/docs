{
  "name": "@app-tour/workspace-booking-ws2",
  "version": "0.1.0",
  "private": true,
  "description": "Booking-ws2 — second product Booking workspace (CASE_A capacity policy vs Denali)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./host/booking": {
      "types": "./dist/booking/index.d.ts",
      "default": "./dist/booking/index.js"
    },
    "./host/bookings": {
      "types": "./dist/bookings/index.d.ts",
      "default": "./dist/bookings/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test \"test/**/*.spec.ts\""
  },
  "dependencies": {
    "@app-tour/booking-http-contracts": "workspace:*",
    "@app-tour/workspace-sdk": "workspace:*"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
