{
  "id": "booking-ws2",
  "version": 1,
  "package": "@app-tour/workspace-booking-ws2",
  "workspaceTypes": [
    "booking-ws2"
  ],
  "plugin": {
    "entry": "./plugin",
    "export": "getBookingWs2WorkspacePlugin"
  },
  "workspaceBooking": {
    "supported": true,
    "defaultModuleEnabledWhenUnset": true,
    "workspaceTypeExport": "BOOKING_WS2_WORKSPACE_TYPE",
    "capabilities": {
      "enabled": true,
      "publicCreate": {
        "enabled": true,
        "mode": "create-pipeline"
      },
      "operatorCreate": {
        "enabled": true,
        "mode": "create-pipeline"
      },
      "validation": {
        "enabled": true,
        "mode": "base-shape"
      },
      "capacity": {
        "enabled": true,
        "mode": "booking-owned"
      },
      "approval": {
        "enabled": true,
        "mode": "host-lifecycle"
      },
      "eventReaction": {
        "enabled": false,
        "mode": "none"
      }
    },
    "publicBooking": {
      "module": "./booking",
      "export": "BookingWs2PublicAdapter"
    },
    "capacityPolicy": {
      "module": "./booking",
      "export": "BookingWs2CapacityPolicyAdapter"
    },
    "validationPolicy": {
      "module": "./booking",
      "export": "BookingWs2ValidationPolicyAdapter"
    },
    "eventReaction": {
      "module": "./booking",
      "export": "BookingWs2EventReactionAdapter"
    },
    "opsManifest": {
      "module": "./bookings",
      "defaultExport": "DEFAULT_BOOKING_OPS_MANIFEST",
      "resolveFromThemeExport": "resolveBookingOpsManifestFromTheme"
    }
  }
}
