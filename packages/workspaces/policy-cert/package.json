{
  "name": "@app-tour/workspace-policy-cert",
  "version": "0.1.0",
  "private": true,
  "description": "CW8-03 synthetic workspace — profile + equipment block + workspacePolicy proof",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/policy-cert.plugin.d.ts",
      "default": "./dist/policy-cert.plugin.js"
    },
    "./policy/tour-policy": {
      "types": "./dist/policy/tour-policy.d.ts",
      "default": "./dist/policy/tour-policy.js"
    },
    "./host/policy/tour-policy": {
      "types": "./dist/policy/tour-policy.d.ts",
      "default": "./dist/policy/tour-policy.js"
    },
    "./theme/tokens.css": "./theme/tokens.css"
  },
  "files": [
    "dist",
    "theme/tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test \"test/**/*.spec.ts\""
  },
  "dependencies": {
    "@app-tour/design-tokens": "workspace:*",
    "@app-tour/platform-core": "workspace:*",
    "@app-tour/workspace-sdk": "workspace:*"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
