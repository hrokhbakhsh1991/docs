# Copy to /opt/app-tour/env/api.env (outside git — survives deploys)
# Server profile: DB-backed dev mode until Melipayamak OTP + prod hardening.

PORT=3001
NODE_ENV=development
STORAGE_DRIVER=prisma

DATABASE_URL=postgresql://app_tour:change-me-strong-password@127.0.0.1:5433/app_tour_prod
DATABASE_URL_ADMIN=postgresql://app_tour:change-me-strong-password@127.0.0.1:5433/app_tour_prod

REDIS_URL=redis://127.0.0.1:6379

MINIO_ENDPOINT=http://127.0.0.1:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=app-tour-prod

OUTBOX_RELAY_ENABLED=false

# OTP — replace with Melipayamak before NODE_ENV=production
AUTH_ALLOW_DEV_STATIC_OTP=true
OTP_FIXTURE_CODE=1234
OPERATOR_OWNER_MOBILE=+989121000001

# Generate once: cd apps/api && pnpm run bootstrap:dev-jwt >> /opt/app-tour/env/api.env
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AUTH_JWT_ISSUER=tour-ops
# AUTH_JWT_AUDIENCE=tour-ops-api
