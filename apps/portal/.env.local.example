# @apps/portal — guest registration shell (DEC-P11-014)
# Copy to .env.local for overrides (optional in dev — guest-surface-host resolveTourOpsApiBaseUrl)
ALLOW_DEV_WEB_SESSION=true

# Fallback tenant when host map misses (operator smoke default)
TOUR_OPS_DEV_TENANT_ID=00000000-0000-4000-8000-000000000014
# Denali dev tenant: use portal.denali.localhost:3003 (host map → …000003) — M↔P cookie share
# Legacy denali.portal.localhost still works for portal-only (no marketing header share)

TOUR_OPS_API_URL=http://127.0.0.1:3001

# P4.4 — optional: warm all trunk workspace plugins at process boot (default: off; layout warms active pluginId)
# PORTAL_WARM_ALL_PLUGINS=1

# Guest bootstrap + branding fetch cache (seconds) — shared M+P via guest-surface-host (M7.1 / M14.1)
GUEST_BOOTSTRAP_REVALIDATE_SECONDS=60
GUEST_BRANDING_REVALIDATE_SECONDS=60
# Legacy alias (still read when GUEST_BRANDING_REVALIDATE_SECONDS unset):
# MARKETING_BRANDING_REVALIDATE_SECONDS=60

# Marketing back-links (WRS — dev canonical)
# MARKETING_PUBLIC_BASE_URL=http://operator.localhost:3002
# MARKETING_DEV_PORT=3002

# Local M↔P (no /etc/hosts): open http://portal.denali.localhost:3003 + http://denali.localhost:3002
# Cookie Domain=denali.localhost (PCMS-COOK-03). Marketing Sign-in links use portal.{club}.localhost.
#
# Custom apex (optional): /etc/hosts → denali.club portal.denali.club admin.denali.club
# PORTAL_PUBLIC_BASE_URL=http://portal.denali.club:3003
# MARKETING_PUBLIC_BASE_URL=http://denali.club:3002
# Production HTTPS:
# PORTAL_PUBLIC_BASE_URL=https://portal.denali.club
# MARKETING_PUBLIC_BASE_URL=https://denali.club
