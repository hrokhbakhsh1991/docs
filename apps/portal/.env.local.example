# @apps/portal — guest registration shell (DEC-P11-014)
# Copy to .env.local for overrides (optional in dev — guest-surface-host resolveTourOpsApiBaseUrl)
ALLOW_DEV_WEB_SESSION=true

# Fallback tenant when host map misses (operator smoke default)
TOUR_OPS_DEV_TENANT_ID=00000000-0000-4000-8000-000000000014
# Denali dev tenant: use denali.portal.localhost:3003 (host map → …000003) — no env override needed

TOUR_OPS_API_URL=http://127.0.0.1:3001

