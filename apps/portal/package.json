{
  "name": "@apps/portal",
  "version": "0.1.0",
  "private": true,
  "description": "User portal shell — public catalog registration (MAP §3.5, DEC-P11-014)",
  "scripts": {
    "guard:import-boundary": "node ../../scripts/guards/import-boundary-ast.mjs",
    "guard:portal-member-profile-boundary": "node ../../scripts/guards/guard-portal-member-profile-boundary.mjs",
    "guard:architecture-truth": "node ../../scripts/guards/architecture-truth-guard.mjs",
    "predev": "pnpm run guard:import-boundary && pnpm run guard:portal-member-profile-boundary && pnpm run guard:architecture-truth && pnpm --filter @app-tour/catalog-registration-flow-ui run build",
    "dev": "next dev --port 3003",
    "prebuild": "pnpm run guard:import-boundary && pnpm run guard:portal-member-profile-boundary && pnpm run guard:architecture-truth && rm -rf .next",
    "build": "bash ../../scripts/next-build-with-retry.sh",
    "prelint": "pnpm run guard:import-boundary && pnpm run guard:portal-member-profile-boundary && pnpm run guard:architecture-truth",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" --max-warnings 0 && tsc --noEmit",
    "test": "node --import ./test/css-hook.mjs --import tsx --test test/**/*.spec.ts",
    "test:smoke": "playwright test -c playwright.portal.config.ts",
    "test:smoke:custom-apex": "playwright test -c playwright.portal-custom-apex.config.ts",
    "test:smoke:visual": "playwright test -c playwright.portal-visual.config.ts",
    "test:smoke:visual:update": "playwright test -c playwright.portal-visual.config.ts --update-snapshots",
    "test:smoke:visual:urban": "playwright test -c playwright.portal-visual-urban.config.ts",
    "test:smoke:visual:urban:update": "playwright test -c playwright.portal-visual-urban.config.ts --update-snapshots",
    "test:smoke:visual:guest-club": "playwright test -c playwright.portal-visual-guest-club.config.ts",
    "test:smoke:visual:guest-club:update": "playwright test -c playwright.portal-visual-guest-club.config.ts --update-snapshots",
    "test:smoke:visual:matrix": "pnpm run test:smoke:visual && pnpm run test:smoke:visual:urban && pnpm run test:smoke:visual:guest-club",
    "test:smoke:install": "playwright install chromium",
    "start": "next start --port 3003"
  },
  "dependencies": {
    "@app-tour/catalog-registration-auth": "workspace:*",
    "@app-tour/catalog-registration-flow-ui": "workspace:*",
    "@app-tour/design-tokens": "workspace:*",
    "@app-tour/guest-surface-host": "workspace:*",
    "@app-tour/guest-workspace-runtime": "workspace:*",
    "@app-tour/session-client": "workspace:*",
    "@app-tour/tenant-kernel": "workspace:*",
    "@app-tour/theme-react": "workspace:*",
    "@app-tour/ui-primitives": "workspace:*",
    "@app-tour/workspace-harbor": "workspace:*",
    "@app-tour/workspace-plugin-host": "workspace:*",
    "@app-tour/workspace-sdk": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^15.1.8",
    "next-intl": "^4.11.1",
    "postcss": "^8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@playwright/test": "^1.51.1",
    "eslint": "^8.57.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
