# Operator admin client workspace bundles (non-secret build-time flags).
# Enable only workspaces included in the target deployment profile.
ALLOW_DENALI_WEB_PLUGIN=true
ALLOW_URBAN_WEB_PLUGIN=false

# Local BFF → API endpoint.
TOUR_OPS_API_URL=http://127.0.0.1:3001
API_INTERNAL_URL=http://127.0.0.1:3001
