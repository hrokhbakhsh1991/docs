# @apps/web — Phase 3.2 local shell
ALLOW_DEV_WEB_SESSION=true

# Server-only dev identity (preferred over NEXT_PUBLIC_* in layout)
TOUR_OPS_DEV_USER_ID=dev-user
TOUR_OPS_DEV_TENANT_ID=dev-tenant-local
TOUR_OPS_DEV_WORKSPACE_ID=default
TOUR_OPS_DEV_ACTOR_ROLE=admin
TOUR_OPS_DEV_MEMBERSHIP_STATUS=ACTIVE

# API bridge (R3)
TOUR_OPS_API_URL=http://127.0.0.1:3001

# Denali draft unification rollout (Track C — default off)
# NEXT_PUBLIC_DRAFT_UNIFICATION_V3=off|shadow|on

# Public catalog redirect target (M2b — optional override)
# MARKETING_PUBLIC_BASE_URL=http://shop.urban.localhost:3002
# MARKETING_DEV_PORT=3002
