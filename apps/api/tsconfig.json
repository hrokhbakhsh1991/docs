{
  "extends": "@app-tour/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@app-tour/workspace-denali": ["../../packages/workspaces/denali/dist/index"],
      "@app-tour/workspace-denali/plugin": ["../../packages/workspaces/denali/dist/denali.plugin"],
      "@app-tour/workspace-denali/host/http": ["../../packages/workspaces/denali/dist/http/index"],
      "@app-tour/workspace-denali/wizard/validation": [
        "../../packages/workspaces/denali/dist/wizard/denali-wizard-validation"
      ],
      "@app-tour/workspace-denali/settings/equipment-compatible-categories": [
        "../../packages/workspaces/denali/dist/settings/equipment-compatible-categories"
      ],
      "@app-tour/workspace-denali/settings/equipment-icon-registry": [
        "../../packages/workspaces/denali/dist/settings/equipment-icon-registry"
      ],
      "@app-tour/workspace-denali/host/tours": ["../../packages/workspaces/denali/dist/tours/index"],
      "@app-tour/workspace-denali/host/finance": [
        "../../packages/workspaces/denali/dist/finance/index"
      ],
      "@app-tour/workspace-denali/host/roster": [
        "../../packages/workspaces/denali/dist/roster/index"
      ],
      "@app-tour/workspace-denali/host/finance/case-read": [
        "../../packages/workspaces/denali/dist/finance/case-read/index"
      ],
      "@app-tour/workspace-denali/host/finance/api-tour-created-adapter": [
        "../../packages/workspaces/denali/dist/finance/api-tour-created-adapter"
      ],
      "@app-tour/workspace-denali/host/finance/manifest": [
        "../../packages/workspaces/denali/dist/finance/finance-ops-manifest"
      ],
      "@app-tour/workspace-urban/plugin": ["../../packages/workspaces/urban/dist/urban.plugin"],
      "@app-tour/workspace-urban/host/http": ["../../packages/workspaces/urban/dist/http/index"],
      "@app-tour/workspace-urban/catalog": ["../../packages/workspaces/urban/dist/catalog/index"],
      "@app-tour/workspace-urban/tours": ["../../packages/workspaces/urban/dist/tours/index"],
      "@app-tour/workspace-urban/auth": ["../../packages/workspaces/urban/dist/auth/index"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
