# @apps/api — local dev only (Docker: infra/docker-compose.yml)
# Copy: cp apps/api/.env.local.example apps/api/.env.local
# Then: pnpm infra:up && pnpm --filter @apps/api run db:migrate:deploy && pnpm --filter @apps/api run db:seed
#
# Do NOT point this file at the VPS. For remote infra see apps/api/.env.vps-tunnel.example

NODE_ENV=development
PORT=3001

STORAGE_DRIVER=prisma
# Port 5434 avoids conflict when :5433 is forwarded to VPS (Cursor/SSH).
DATABASE_URL=postgresql://app_tour:app_tour@127.0.0.1:5434/app_tour_dev?connection_limit=32&connect_timeout=30&pool_timeout=30
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:5434/app_tour_dev?connection_limit=8&connect_timeout=30&pool_timeout=30
REDIS_URL=redis://127.0.0.1:6379

MINIO_ENDPOINT=http://127.0.0.1:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=app-tour-dev

OUTBOX_RELAY_ENABLED=false
TENANT_RATE_LIMIT_ENABLED=false
PROJECTION_AUTO_RECONCILE_ENABLED=false
PRIORITY_LOAD_SHED_ENABLED=false

# Dev login — OTP 1234 when AUTH_ALLOW_DEV_STATIC_OTP=true
OPERATOR_OWNER_MOBILE=+15550001001
AUTH_ALLOW_DEV_STATIC_OTP=true

# Generate once: cd apps/api && pnpm run bootstrap:dev-jwt >> .env.local
# AUTH_JWT_ISSUER=tour-ops
# AUTH_JWT_AUDIENCE=tour-ops-api
# AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
