  @@unique([tenantId, ticketId, entityType, entityId], map: "uq_ticket_links_tenant_ticket_entity")
  @@index([tenantId, entityType, entityId], map: "idx_ticket_links_tenant_entity")
  @@map("ticket_links")
}

/// TKT-001 Phase D1 — tenant-scoped operational tags.
model TicketTag {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  code       String    @db.VarChar(64)
  label      String
