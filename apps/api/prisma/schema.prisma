// Phase 5 data layer — canonical_data SoT, projections, outbox, audit
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                          String                       @id @default(uuid()) @db.Uuid
  subdomain                   String                       @unique
  workspaceType               String                       @default("starter") @map("workspace_type")
  status                      String                       @default("active")
  theme                       Json                         @default("{}")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  offboardingStartedAt        DateTime?                    @map("offboarding_started_at") @db.Timestamptz
  scheduledDeletionAt         DateTime?                    @map("scheduled_deletion_at") @db.Timestamptz
  tours                       Tour[]
  outboxEvents                OutboxEvent[]
  auditEvents                 AuditEvent[]
  httpIdempotencyRecords      HttpIdempotencyRecord[]
  processedDomainEvents       ProcessedDomainEvent[]
  tenantRoute                 TenantRoute?
  payments                    Payment[]
  paymentReceipts             PaymentReceipt[]
  financeSchedules            FinanceSchedule[]
  financeCommercialQuotes     FinanceCommercialQuote[]
  financePaymentHolds         FinancePaymentHold[]
  financeRefunds              FinanceRefund[]
  walletAccounts              WalletAccount[]
  walletTransactions          WalletTransaction[]
  walletLedgerEntries         WalletLedgerEntry[]
  urbanRegistrations          UrbanRegistration[]
  userTenants                 UserTenant[]
  operatorPendingInvites      OperatorPendingInvite[]
  operatorRegistrations       OperatorRegistration[]
  tenantConfigs               TenantConfig[]
  tenantDomains               TenantDomain[]
  workspaceEquipment          WorkspaceEquipment[]
  workspaceTourThemes         WorkspaceTourTheme[]
  workspaceGuideLanguages     WorkspaceGuideLanguage[]
  workspaceTourPresets        WorkspaceTourPreset[]
  workspaceRegions            WorkspaceRegion[]
  workspaceDestinations       WorkspaceDestination[]
  operatorSettingsAuditEvents OperatorSettingsAuditEvent[]
  operatorUserRoleAudits      OperatorUserRoleAudit[]
  workspaceDraftSnapshots     WorkspaceDraftSnapshot[]
  workspaceDraftEvents        WorkspaceDraftEvent[]
  workspaceTelegramBots       WorkspaceTelegramBot[]
  integrationConnections      IntegrationConnection[]
  integrationDeliveryJobs     IntegrationDeliveryJob[]
  denaliExposureReminderActivations DenaliExposureReminderActivation[]
  integrationEventPolicies    IntegrationEventPolicy[]
  exposureProfiles            ExposureProfile[]
  exposureIntents             ExposureIntent[]
  integrationSecrets          IntegrationSecret[]
  portalMemberPlans           PortalMemberPlan[]
  subscription                TenantSubscription?
  workspaceDefinitionId       String?                      @map("workspace_definition_id")
  workspaceDefinitionVersion  Int?                         @map("workspace_definition_version")
  workspaceDefinition         WorkspaceDefinition?         @relation(fields: [workspaceDefinitionId], references: [id], onDelete: SetNull)
  financeReconFindings        FinanceReconFinding[]
  financeReconActions         FinanceReconAction[]
  outboxReplayRuns            OutboxReplayRun[]
  tickets                     Ticket[]
  ticketMessages              TicketMessage[]
  ticketEvents                TicketEvent[]
  ticketAttachments           TicketAttachment[]
  ticketLinks                 TicketLink[]
  ticketTags                  TicketTag[]
  ticketTagAssignments        TicketTagAssignment[]
  ticketQueues                TicketQueue[]
  ticketTeams                 TicketTeam[]
  ticketTeamMembers           TicketTeamMember[]
  ticketNotifications         TicketNotification[]
  ticketNotificationDeliveries TicketNotificationDelivery[]
  ticketSlaPolicies           TicketSlaPolicy[]
  ticketSlaStates             TicketSlaState[]
  ticketSlaEscalationActivations TicketSlaEscalationActivation[]

  @@map("tenants")
}

/// P3-A — logical workspace vertical (metadata platform).
model WorkspaceDefinition {
  id          String                       @id
  displayName String                       @map("display_name")
  status      String                       @default("draft")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  versions    WorkspaceDefinitionVersion[]
  tenants     Tenant[]

  @@map("workspace_definitions")
}

/// P3-A — immutable published metadata snapshot (JSON payload).
model WorkspaceDefinitionVersion {
  id                         String              @id @default(uuid()) @db.Uuid
  definitionId               String              @map("definition_id")
  version                    Int
  pluginApiVersion           Int                 @default(1) @map("plugin_api_version")
  payload                    Json
  checksum                   String
  publishedAt                DateTime?           @map("published_at") @db.Timestamptz
  createdByPlatformOpsUserId String?             @map("created_by_platform_ops_user_id") @db.Uuid
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz
  definition                 WorkspaceDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, version], map: "uq_workspace_definition_versions_def_version")
  @@index([definitionId], map: "idx_workspace_definition_versions_definition_id")
  @@map("workspace_definition_versions")
}

/// Phase 7.7 — pool vs silo connection routing (DEC-P7-004).
model TenantRoute {
  tenantId    String   @id @map("tenant_id") @db.Uuid
  tier        String   @default("pool")
  databaseUrl String?  @map("database_url")
  schemaName  String?  @map("schema_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_routes")
}

model Tour {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  canonical     Json                @map("canonical_data")
  title         String?
  publishStatus String              @default("draft") @map("publish_status")
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz
  city          String?
  venueName     String?             @map("venue_name")
  startDate     DateTime?           @map("start_date") @db.Date
  endDate       DateTime?           @map("end_date") @db.Date
  schemaVersion Int                 @default(1) @map("schema_version")
  rowVersion    Int                 @default(1) @map("row_version")
  createdAt     DateTime            @default(now()) @map("created_at")
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  registrations UrbanRegistration[]

  @@unique([tenantId, id])
  @@index([tenantId], map: "idx_tours_tenant_id")
  @@index([tenantId, title], map: "idx_tours_tenant_title")
  @@index([tenantId, publishStatus, publishedAt(sort: Desc)], map: "idx_tours_tenant_publish_catalog")
  @@index([tenantId, city, publishStatus], map: "idx_tours_tenant_city_publish")
  @@map("tours")
}

/// Phase 8.2 — public registration intake (catalog flow).
model UrbanRegistration {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tourId    String   @map("tour_id") @db.Uuid
  email     String
  fullName  String   @map("full_name")
  phone     String?
  partySize Int?     @map("party_size")
  status    String   @default("waitlist")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tour      Tour     @relation(fields: [tenantId, tourId], references: [tenantId, id])

  @@unique([tenantId, tourId, email], map: "uq_urban_reg_tenant_tour_email")
  @@index([tenantId, tourId, createdAt(sort: Desc)], map: "idx_urban_reg_tenant_tour_created")
  @@index([tenantId, email], map: "idx_urban_reg_tenant_email")
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_urban_reg_tenant_status_created")
  @@map("urban_registrations")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json      @default("{}")
  status        String    @default("pending")
  domainEventId String?   @map("domain_event_id")
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")
  lastError     Json?     @map("last_error")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, domainEventId])
  @@index([tenantId, status, createdAt])
  @@map("outbox_events")
}

/// Phase 3.17 — append-only production outbox replay audit (ops).
model OutboxReplayRun {
  id              String    @id @default(uuid()) @db.Uuid
  mode            String
  dryRun          Boolean   @default(true) @map("dry_run")
  confirmed       Boolean   @default(false)
  actorUserId     String?   @map("actor_user_id")
  tenantId        String?   @map("tenant_id") @db.Uuid
  workspaceType   String?   @map("workspace_type")
  fromCreatedAt   DateTime? @map("from_created_at") @db.Timestamptz
  toCreatedAt     DateTime? @map("to_created_at") @db.Timestamptz
  eventTypePrefix String?   @map("event_type_prefix")
  requestedIds    Json      @default("[]") @map("requested_ids")
  replayed        Int       @default(0)
  skipped         Int       @default(0)
  failed          Int       @default(0)
  durationMs      Int       @default(0) @map("duration_ms")
  details         Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("outbox_replay_runs")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@map("audit_events")
}

/// P0 DEC-006 — HTTP Idempotency-Key replay store (POST /tours).
model HttpIdempotencyRecord {
  tenantId       String    @map("tenant_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  status         String    @default("processing")
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  /// Absolute lease expiry for in-flight owners (Phase 4B lease reclaim).
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz
  /// Opaque owner token; heartbeats / complete / failure cleanup must match.
  leaseOwner     String?   @map("lease_owner")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@id([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([status, leaseUntil])
  @@map("http_idempotency_records")
}

/// Phase 5.4-S4 — consumer idempotency log (domain_event_id per tenant).
model ProcessedDomainEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  domainEventId String   @map("domain_event_id")
  processedAt   DateTime @default(now()) @map("processed_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, domainEventId])
  @@index([tenantId, processedAt])
  @@map("processed_domain_events")
}

/// Phase 9.7 — manual/online payment intents (R1 legacy parity).
model Payment {
  id                      String           @id @default(uuid()) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  registrationId          String           @map("registration_id") @db.Uuid
  amount                  String
  currency                String           @db.VarChar(8)
  method                  String           @default("Manual")
  provider                String           @default("manual")
  providerPaymentId       String?          @map("provider_payment_id")
  /// SHA-256 hex of HTTP Idempotency-Key for manual create (business retry-safety).
  creationIdempotencyKey  String?          @map("creation_idempotency_key")
  status                  String           @default("Pending")
  paidAt                  DateTime?        @map("paid_at")
  failedAt                DateTime?        @map("failed_at")
  refundedAt              DateTime?        @map("refunded_at")
  ledgerJournalId         String?          @map("ledger_journal_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  tenant                  Tenant           @relation(fields: [tenantId], references: [id])
  receipts                PaymentReceipt[]

  @@unique([tenantId, creationIdempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, registrationId])
  @@map("payments")
}

/// PR23-E2 — finance-owned refund aggregate (money only when status = Completed).
model FinanceRefund {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  registrationId          String    @map("registration_id") @db.Uuid
  paymentId               String?   @map("payment_id") @db.Uuid
  sourceKind              String    @map("source_kind")
  amountMinor             String    @map("amount_minor")
  currency                String    @db.VarChar(8)
  reasonCode              String    @map("reason_code")
  reasonNote              String?   @map("reason_note")
  status                  String
  requestedAt             DateTime  @map("requested_at")
  requestedByUserId       String    @map("requested_by_user_id")
  approvedAt              DateTime? @map("approved_at")
  approvedByUserId        String?   @map("approved_by_user_id")
  rejectedAt              DateTime? @map("rejected_at")
  rejectedByUserId        String?   @map("rejected_by_user_id")
  rejectNote              String?   @map("reject_note")
  cancelledAt             DateTime? @map("cancelled_at")
  cancelledByUserId       String?   @map("cancelled_by_user_id")
  completedAt             DateTime? @map("completed_at")
  completedByUserId       String?   @map("completed_by_user_id")
  completionNote          String?   @map("completion_note")
  evidenceFileKey         String?   @map("evidence_file_key")
  evidenceNote            String?   @map("evidence_note")
  creationIdempotencyKey  String?   @map("creation_idempotency_key")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, creationIdempotencyKey])
  @@index([tenantId, registrationId])
  @@index([tenantId, paymentId])
  @@index([tenantId, status])
  @@map("finance_refunds")
}

/// Finance recon — open/resolved mismatch findings (ops; admin Prisma).
model FinanceReconFinding {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  code           String
  severity       String
  status         String               @default("open")
  fingerprint    String
  paymentId      String?              @map("payment_id") @db.Uuid
  registrationId String?              @map("registration_id") @db.Uuid
  outboxEventId  String?              @map("outbox_event_id") @db.Uuid
  details        Json                 @default("{}")
  detectedAt     DateTime             @default(now()) @map("detected_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz
  resolvedBy     String?              @map("resolved_by")
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  actions        FinanceReconAction[]

  @@unique([tenantId, code, fingerprint])
  @@index([tenantId, status, code])
  @@map("finance_recon_findings")
}

/// Append-only recon repair / ignore audit.
model FinanceReconAction {
  id                String              @id @default(uuid()) @db.Uuid
  findingId         String              @map("finding_id") @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  action            String
  actorUserId       String?             @map("actor_user_id")
  dryRun            Boolean             @default(true) @map("dry_run")
  mode              String              @default("preview")
  reason            String?
  rollbackStrategy  String              @default("ticket_only") @map("rollback_strategy")
  result            String
  payload           Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  finding           FinanceReconFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  tenant            Tenant              @relation(fields: [tenantId], references: [id])

  @@index([findingId, createdAt])
  @@index([tenantId, createdAt])
  @@map("finance_recon_actions")
}

/// Phase 9.7 — manual payment proof + operator review queue.
model PaymentReceipt {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  paymentId          String    @map("payment_id") @db.Uuid
  fileKey            String    @map("file_key")
  status             String    @default("Pending")
  note               String?
  reviewedByUserId   String?   @map("reviewed_by_user_id")
  reviewedAt         DateTime? @map("reviewed_at")
  reviewNote         String?   @map("review_note")
  ledgerJournalId    String?   @map("ledger_journal_id") @db.Uuid
  /// SHA-256 hex of HTTP Idempotency-Key for receipt submit (business retry-safety).
  idempotencyKeyHash String?   @map("idempotency_key_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  payment            Payment   @relation(fields: [paymentId], references: [id])

  @@unique([tenantId, idempotencyKeyHash])
  @@index([tenantId, status])
  @@index([tenantId, paymentId])
  @@map("payment_receipts")
}

/// Phase 9.7 R3 — installment / deposit schedule rows (one per sequence slot).
model FinanceSchedule {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  registrationId   String   @map("registration_id") @db.Uuid
  sequence         Int
  label            String
  dueAt            DateTime @map("due_at")
  amountMinor      String   @map("amount_minor")
  paidMinor        String   @default("0") @map("paid_minor")
  status           String
  linkedPaymentId  String?  @map("linked_payment_id") @db.Uuid
  graceDays        Int?     @map("grace_days")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, registrationId, sequence])
  @@index([tenantId, registrationId])
  @@index([tenantId, status])
  @@map("finance_schedules")
}

/// CQ-1C — immutable commercial quote versions per registration (Finance-owned).
model FinanceCommercialQuote {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  registrationId      String   @map("registration_id") @db.Uuid
  versionNumber       Int      @map("version_number")
  status              String
  grossMinor          String   @map("gross_minor")
  payableMinor        String   @map("payable_minor")
  currency            String   @db.VarChar(8)
  source              String
  calculationVersion  String   @map("calculation_version")
  supersedesVersionId String?  @map("supersedes_version_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  memberDiscountPercentageApplied Int?    @map("member_discount_percentage_applied")
  memberDiscountMinor             String? @map("member_discount_minor")
  memberDiscountMemberUserId      String? @map("member_discount_member_user_id") @db.Uuid
  memberDiscountMembershipReference String? @map("member_discount_membership_reference")
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, registrationId, versionNumber])
  @@index([tenantId, registrationId])
  @@index([tenantId, registrationId, status])
  @@map("finance_commercial_quotes")
}

/// DP1 — Finance Payment Hold (DEN-PROD-04).
model FinancePaymentHold {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  registrationId String    @map("registration_id") @db.Uuid
  status         String
  dueAt          DateTime  @map("due_at")
  policyHours    Int       @map("policy_hours")
  extendedCount  Int       @default(0) @map("extended_count")
  satisfiedAt    DateTime? @map("satisfied_at")
  expiredAt      DateTime? @map("expired_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, registrationId])
  @@index([tenantId, status, dueAt])
  @@map("finance_payment_holds")
}

/// WALLET-P2C — member stored-value account (derived balance from ledger entries).
model WalletAccount {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  workspaceId String              @map("workspace_id")
  userId      String              @map("user_id") @db.Uuid
  status      String              @default("active")
  currency    String              @db.VarChar(8)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  ledgerEntries WalletLedgerEntry[]

  @@unique([tenantId, workspaceId, userId, currency])
  @@index([tenantId, workspaceId, userId])
  @@map("wallet_accounts")
}

/// WALLET-P2C — append-only wallet transaction aggregate root.
model WalletTransaction {
  id                      String              @id @default(uuid()) @db.Uuid
  tenantId                String              @map("tenant_id") @db.Uuid
  workspaceId             String              @map("workspace_id")
  accountId               String              @map("account_id") @db.Uuid
  kind                    String
  status                  String
  amountMinor             String              @map("amount_minor")
  currency                String              @db.VarChar(8)
  creationIdempotencyKey  String              @map("creation_idempotency_key")
  commandFingerprint      String              @map("command_fingerprint")
  referenceType           String?             @map("reference_type")
  referenceId             String?             @map("reference_id")
  actorUserId             String              @map("actor_user_id") @db.Uuid
  actorRole               String              @map("actor_role")
  reversesTransactionId   String?             @map("reverses_transaction_id") @db.Uuid
  postedAt                DateTime?           @map("posted_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account                 WalletAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reversesTransaction     WalletTransaction?  @relation("WalletTransactionReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversalOf              WalletTransaction[] @relation("WalletTransactionReversal")
  ledgerEntries           WalletLedgerEntry[]

  @@unique([tenantId, creationIdempotencyKey])
  @@index([tenantId, accountId])
  @@index([tenantId, accountId, status])
  @@index([tenantId, reversesTransactionId])
  @@map("wallet_transactions")
}

/// WALLET-P2C — immutable posted ledger entry (balance derived from sum).
model WalletLedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  accountId     String            @map("account_id") @db.Uuid
  direction     String
  amountMinor   String            @map("amount_minor")
  currency      String            @db.VarChar(8)
  postedAt      DateTime          @map("posted_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transaction   WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@index([tenantId, transactionId])
  @@map("wallet_ledger_entries")
}

/// Phase 9.1 — global operator identity (mobile login).
model User {
  id          String       @id @default(uuid()) @db.Uuid
  mobile      String       @unique
