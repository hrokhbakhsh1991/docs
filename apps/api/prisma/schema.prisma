// Phase 5 data layer — canonical_data SoT, projections, outbox, audit
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                          String                       @id @default(uuid()) @db.Uuid
  subdomain                   String                       @unique
  workspaceType               String                       @default("starter") @map("workspace_type")
  status                      String                       @default("active")
  theme                       Json                         @default("{}")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  offboardingStartedAt        DateTime?                    @map("offboarding_started_at") @db.Timestamptz
  scheduledDeletionAt         DateTime?                    @map("scheduled_deletion_at") @db.Timestamptz
  tours                       Tour[]
  outboxEvents                OutboxEvent[]
  auditEvents                 AuditEvent[]
  httpIdempotencyRecords      HttpIdempotencyRecord[]
  processedDomainEvents       ProcessedDomainEvent[]
  tenantRoute                 TenantRoute?
  payments                    Payment[]
  paymentReceipts             PaymentReceipt[]
  financeSchedules            FinanceSchedule[]
  financeRefunds              FinanceRefund[]
  urbanRegistrations          UrbanRegistration[]
  userTenants                 UserTenant[]
  operatorPendingInvites      OperatorPendingInvite[]
  operatorRegistrations       OperatorRegistration[]
  tenantConfigs               TenantConfig[]
  tenantDomains               TenantDomain[]
  workspaceEquipment          WorkspaceEquipment[]
  workspaceTourThemes         WorkspaceTourTheme[]
  workspaceGuideLanguages     WorkspaceGuideLanguage[]
  workspaceTourPresets        WorkspaceTourPreset[]
  workspaceRegions            WorkspaceRegion[]
  workspaceDestinations       WorkspaceDestination[]
  operatorSettingsAuditEvents OperatorSettingsAuditEvent[]
  operatorUserRoleAudits      OperatorUserRoleAudit[]
  workspaceDraftSnapshots     WorkspaceDraftSnapshot[]
  workspaceDraftEvents        WorkspaceDraftEvent[]
  workspaceTelegramBots       WorkspaceTelegramBot[]
  integrationConnections      IntegrationConnection[]
  integrationDeliveryJobs     IntegrationDeliveryJob[]
  denaliExposureReminderActivations DenaliExposureReminderActivation[]
  integrationEventPolicies    IntegrationEventPolicy[]
  exposureProfiles            ExposureProfile[]
  exposureIntents             ExposureIntent[]
  integrationSecrets          IntegrationSecret[]
  portalMemberPlans           PortalMemberPlan[]
  subscription                TenantSubscription?
  workspaceDefinitionId       String?                      @map("workspace_definition_id")
  workspaceDefinitionVersion  Int?                         @map("workspace_definition_version")
  workspaceDefinition         WorkspaceDefinition?         @relation(fields: [workspaceDefinitionId], references: [id], onDelete: SetNull)
  financeReconFindings        FinanceReconFinding[]
  financeReconActions         FinanceReconAction[]
  outboxReplayRuns            OutboxReplayRun[]

  @@map("tenants")
}

/// P3-A — logical workspace vertical (metadata platform).
model WorkspaceDefinition {
  id          String                       @id
  displayName String                       @map("display_name")
  status      String                       @default("draft")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  versions    WorkspaceDefinitionVersion[]
  tenants     Tenant[]

  @@map("workspace_definitions")
}

/// P3-A — immutable published metadata snapshot (JSON payload).
model WorkspaceDefinitionVersion {
  id                         String              @id @default(uuid()) @db.Uuid
  definitionId               String              @map("definition_id")
  version                    Int
  pluginApiVersion           Int                 @default(1) @map("plugin_api_version")
  payload                    Json
  checksum                   String
  publishedAt                DateTime?           @map("published_at") @db.Timestamptz
  createdByPlatformOpsUserId String?             @map("created_by_platform_ops_user_id") @db.Uuid
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz
  definition                 WorkspaceDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, version], map: "uq_workspace_definition_versions_def_version")
  @@index([definitionId], map: "idx_workspace_definition_versions_definition_id")
  @@map("workspace_definition_versions")
}

/// Phase 7.7 — pool vs silo connection routing (DEC-P7-004).
model TenantRoute {
  tenantId    String   @id @map("tenant_id") @db.Uuid
  tier        String   @default("pool")
  databaseUrl String?  @map("database_url")
  schemaName  String?  @map("schema_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_routes")
}

model Tour {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  canonical     Json                @map("canonical_data")
  title         String?
  publishStatus String              @default("draft") @map("publish_status")
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz
  city          String?
  venueName     String?             @map("venue_name")
  startDate     DateTime?           @map("start_date") @db.Date
  endDate       DateTime?           @map("end_date") @db.Date
  schemaVersion Int                 @default(1) @map("schema_version")
  rowVersion    Int                 @default(1) @map("row_version")
  createdAt     DateTime            @default(now()) @map("created_at")
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  registrations UrbanRegistration[]

  @@unique([tenantId, id])
  @@index([tenantId], map: "idx_tours_tenant_id")
  @@index([tenantId, title], map: "idx_tours_tenant_title")
  @@index([tenantId, publishStatus, publishedAt(sort: Desc)], map: "idx_tours_tenant_publish_catalog")
  @@index([tenantId, city, publishStatus], map: "idx_tours_tenant_city_publish")
  @@map("tours")
}

/// Phase 8.2 — public registration intake (catalog flow).
model UrbanRegistration {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tourId    String   @map("tour_id") @db.Uuid
  email     String
  fullName  String   @map("full_name")
  phone     String?
  partySize Int?     @map("party_size")
  status    String   @default("waitlist")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tour      Tour     @relation(fields: [tenantId, tourId], references: [tenantId, id])

  @@unique([tenantId, tourId, email], map: "uq_urban_reg_tenant_tour_email")
  @@index([tenantId, tourId, createdAt(sort: Desc)], map: "idx_urban_reg_tenant_tour_created")
  @@index([tenantId, email], map: "idx_urban_reg_tenant_email")
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_urban_reg_tenant_status_created")
  @@map("urban_registrations")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json      @default("{}")
  status        String    @default("pending")
  domainEventId String?   @map("domain_event_id")
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")
  lastError     Json?     @map("last_error")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, domainEventId])
  @@index([tenantId, status, createdAt])
  @@map("outbox_events")
}

/// Phase 3.17 — append-only production outbox replay audit (ops).
model OutboxReplayRun {
  id              String    @id @default(uuid()) @db.Uuid
  mode            String
  dryRun          Boolean   @default(true) @map("dry_run")
  confirmed       Boolean   @default(false)
  actorUserId     String?   @map("actor_user_id")
  tenantId        String?   @map("tenant_id") @db.Uuid
  workspaceType   String?   @map("workspace_type")
  fromCreatedAt   DateTime? @map("from_created_at") @db.Timestamptz
  toCreatedAt     DateTime? @map("to_created_at") @db.Timestamptz
  eventTypePrefix String?   @map("event_type_prefix")
  requestedIds    Json      @default("[]") @map("requested_ids")
  replayed        Int       @default(0)
  skipped         Int       @default(0)
  failed          Int       @default(0)
  durationMs      Int       @default(0) @map("duration_ms")
  details         Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("outbox_replay_runs")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@map("audit_events")
}

/// P0 DEC-006 — HTTP Idempotency-Key replay store (POST /tours).
model HttpIdempotencyRecord {
  tenantId       String    @map("tenant_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  status         String    @default("processing")
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  /// Absolute lease expiry for in-flight owners (Phase 4B lease reclaim).
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz
  /// Opaque owner token; heartbeats / complete / failure cleanup must match.
  leaseOwner     String?   @map("lease_owner")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@id([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([status, leaseUntil])
  @@map("http_idempotency_records")
}

/// Phase 5.4-S4 — consumer idempotency log (domain_event_id per tenant).
model ProcessedDomainEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  domainEventId String   @map("domain_event_id")
  processedAt   DateTime @default(now()) @map("processed_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, domainEventId])
  @@index([tenantId, processedAt])
  @@map("processed_domain_events")
}

/// Phase 9.7 — manual/online payment intents (R1 legacy parity).
model Payment {
  id                      String           @id @default(uuid()) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  registrationId          String           @map("registration_id") @db.Uuid
  amount                  String
  currency                String           @db.VarChar(8)
  method                  String           @default("Manual")
  provider                String           @default("manual")
  providerPaymentId       String?          @map("provider_payment_id")
  /// SHA-256 hex of HTTP Idempotency-Key for manual create (business retry-safety).
  creationIdempotencyKey  String?          @map("creation_idempotency_key")
  status                  String           @default("Pending")
  paidAt                  DateTime?        @map("paid_at")
  failedAt                DateTime?        @map("failed_at")
  refundedAt              DateTime?        @map("refunded_at")
  ledgerJournalId         String?          @map("ledger_journal_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  tenant                  Tenant           @relation(fields: [tenantId], references: [id])
  receipts                PaymentReceipt[]

  @@unique([tenantId, creationIdempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, registrationId])
  @@map("payments")
}

/// PR23-E2 — finance-owned refund aggregate (money only when status = Completed).
model FinanceRefund {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  registrationId          String    @map("registration_id") @db.Uuid
  paymentId               String?   @map("payment_id") @db.Uuid
  sourceKind              String    @map("source_kind")
  amountMinor             String    @map("amount_minor")
  currency                String    @db.VarChar(8)
  reasonCode              String    @map("reason_code")
  reasonNote              String?   @map("reason_note")
  status                  String
  requestedAt             DateTime  @map("requested_at")
  requestedByUserId       String    @map("requested_by_user_id")
  approvedAt              DateTime? @map("approved_at")
  approvedByUserId        String?   @map("approved_by_user_id")
  rejectedAt              DateTime? @map("rejected_at")
  rejectedByUserId        String?   @map("rejected_by_user_id")
  rejectNote              String?   @map("reject_note")
  cancelledAt             DateTime? @map("cancelled_at")
  cancelledByUserId       String?   @map("cancelled_by_user_id")
  completedAt             DateTime? @map("completed_at")
  completedByUserId       String?   @map("completed_by_user_id")
  completionNote          String?   @map("completion_note")
  evidenceFileKey         String?   @map("evidence_file_key")
  evidenceNote            String?   @map("evidence_note")
  creationIdempotencyKey  String?   @map("creation_idempotency_key")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, creationIdempotencyKey])
  @@index([tenantId, registrationId])
  @@index([tenantId, paymentId])
  @@index([tenantId, status])
  @@map("finance_refunds")
}

/// Finance recon — open/resolved mismatch findings (ops; admin Prisma).
model FinanceReconFinding {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  code           String
  severity       String
  status         String               @default("open")
  fingerprint    String
  paymentId      String?              @map("payment_id") @db.Uuid
  registrationId String?              @map("registration_id") @db.Uuid
  outboxEventId  String?              @map("outbox_event_id") @db.Uuid
  details        Json                 @default("{}")
  detectedAt     DateTime             @default(now()) @map("detected_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz
  resolvedBy     String?              @map("resolved_by")
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  actions        FinanceReconAction[]

  @@unique([tenantId, code, fingerprint])
  @@index([tenantId, status, code])
  @@map("finance_recon_findings")
}

/// Append-only recon repair / ignore audit.
model FinanceReconAction {
  id                String              @id @default(uuid()) @db.Uuid
  findingId         String              @map("finding_id") @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  action            String
  actorUserId       String?             @map("actor_user_id")
  dryRun            Boolean             @default(true) @map("dry_run")
  mode              String              @default("preview")
  reason            String?
  rollbackStrategy  String              @default("ticket_only") @map("rollback_strategy")
  result            String
  payload           Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  finding           FinanceReconFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  tenant            Tenant              @relation(fields: [tenantId], references: [id])

  @@index([findingId, createdAt])
  @@index([tenantId, createdAt])
  @@map("finance_recon_actions")
}

/// Phase 9.7 — manual payment proof + operator review queue.
model PaymentReceipt {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  paymentId          String    @map("payment_id") @db.Uuid
  fileKey            String    @map("file_key")
  status             String    @default("Pending")
  note               String?
  reviewedByUserId   String?   @map("reviewed_by_user_id")
  reviewedAt         DateTime? @map("reviewed_at")
  reviewNote         String?   @map("review_note")
  ledgerJournalId    String?   @map("ledger_journal_id") @db.Uuid
  /// SHA-256 hex of HTTP Idempotency-Key for receipt submit (business retry-safety).
  idempotencyKeyHash String?   @map("idempotency_key_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  payment            Payment   @relation(fields: [paymentId], references: [id])

  @@unique([tenantId, idempotencyKeyHash])
  @@index([tenantId, status])
  @@index([tenantId, paymentId])
  @@map("payment_receipts")
}

/// Phase 9.7 R3 — installment / deposit schedule rows (one per sequence slot).
model FinanceSchedule {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  registrationId   String   @map("registration_id") @db.Uuid
  sequence         Int
  label            String
  dueAt            DateTime @map("due_at")
  amountMinor      String   @map("amount_minor")
  paidMinor        String   @default("0") @map("paid_minor")
  status           String
  linkedPaymentId  String?  @map("linked_payment_id") @db.Uuid
  graceDays        Int?     @map("grace_days")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, registrationId, sequence])
  @@index([tenantId, registrationId])
  @@index([tenantId, status])
  @@map("finance_schedules")
}

/// Phase 9.1 — global operator identity (mobile login).
model User {
  id          String       @id @default(uuid()) @db.Uuid
  mobile      String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships UserTenant[]

  @@map("users")
}

/// Phase 9.1 — tenant membership + JWT sessionVersion invalidation (DEC-P9-012).
/// Owner-DB-1A: partial unique index `uq_user_tenants_one_active_owner`
/// on (tenant_id) WHERE role='owner' AND status='ACTIVE' (SQL migration only —
/// Prisma schema cannot express partial unique indexes).
model UserTenant {
  userId             String   @map("user_id") @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  role               String
  status             String   @default("ACTIVE")
  sessionVersion     Int      @default(1) @map("session_version")
  workspaceId        String?  @map("workspace_id")
  membershipMetadata Json     @default("{}") @map("membership_metadata")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId, status], map: "idx_user_tenants_tenant_status")
  @@map("user_tenants")
}

/// Phase 9.1 — OTP challenge store (single-use · 5m TTL in service layer).
model MobileOtpChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  mobile    String
  purpose   String   @default("login")
  codeHash  String   @default("") @map("code_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([mobile, createdAt(sort: Desc)], map: "idx_mobile_otp_mobile_created")
  @@map("mobile_otp_challenges")
}

/// Phase 9.1/9.4 — pending workspace invite before UserTenant row exists.
model OperatorPendingInvite {
  inviteId        String   @id @default(uuid()) @map("invite_id") @db.Uuid
  inviteToken     String   @unique @map("invite_token") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  phone           String
  role            String
  status          String   @default("INVITED")
  nameNote        String?  @map("name_note")
  invitedByUserId String   @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], map: "idx_operator_pending_invites_tenant_status")
  @@map("operator_pending_invites")
}

/// Phase 9.4 R7 — append-only membership audit for users directory.
model OperatorUserRoleAudit {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  eventKind    String   @default("role_change") @map("event_kind")
  oldRole      String   @map("old_role")
  newRole      String   @map("new_role")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, targetUserId, createdAt(sort: Desc)], map: "idx_operator_user_role_audit_target")
  @@map("operator_user_role_audit")
}

/// Phase 9.5 — operator Command Center registrations (Denali · not urban_registrations).
model OperatorRegistration {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tourId            String    @map("tour_id") @db.Uuid
  tourTitle         String    @map("tour_title")
  guestLabel        String    @map("guest_label")
  guestEmail        String?   @map("guest_email")
  guestPhone        String?   @map("guest_phone")
  partySize         Int       @map("party_size")
  status            String    @default("pending")
  paymentStatus     String    @default("unpaid") @map("payment_status")
  departureAt       DateTime  @map("departure_at")
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  submittedByUserId String    @map("submitted_by_user_id") @db.Uuid
  approvedAt        DateTime? @map("approved_at")
  registrationIntake Json?  @map("registration_intake")
  /// Ops reject reason (optional). Null when never rejected or rejected without reason.
  rejectReason      String?   @map("reject_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, submittedAt(sort: Desc)], map: "idx_operator_registrations_tenant_status")
  @@index([tenantId, tourId, submittedAt(sort: Desc)], map: "idx_operator_registrations_tenant_tour")
  @@index([tenantId, departureAt, id], map: "idx_operator_registrations_tenant_departure_id")
  @@map("operator_registrations")
}

/// Phase 9.6 — versioned tenant config (wizard template · presets advanced).
model TenantConfig {
  tenantId      String   @map("tenant_id") @db.Uuid
  configKey     String   @map("config_key")
  configVersion Int      @map("config_version")
  payload       Json     @default("{}")
  updatedAt     DateTime @updatedAt @map("updated_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, configKey])
  @@map("tenant_config")
}

/// Phase 9.6 — workspace equipment reference catalog.
model WorkspaceEquipment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  category  String?
  iconKey   String?  @map("icon_key")
  themeIds  Json     @default("[]") @map("theme_ids")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sortOrder, name], map: "idx_workspace_equipment_tenant_sort")
  @@map("workspace_equipment")
}

/// Phase 9.6 — tour themes catalog.
model WorkspaceTourTheme {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  name        String
  slug        String
  formProfile String?               @map("form_profile")
  isActive    Boolean               @default(true) @map("is_active")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  presets     WorkspaceTourPreset[]

  @@unique([tenantId, slug])
  @@index([tenantId, sortOrder, name], map: "idx_workspace_tour_themes_tenant_sort")
  @@map("workspace_tour_themes")
}

/// Phase 9.6 — guide languages catalog.
model WorkspaceGuideLanguage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  slug      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, sortOrder, name], map: "idx_workspace_guide_languages_tenant_sort")
  @@map("workspace_guide_languages")
}

/// Phase 9.6 — tour presets catalog.
model WorkspaceTourPreset {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  name        String
  description String?
  themeId     String?             @map("theme_id") @db.Uuid
  isActive    Boolean             @default(true) @map("is_active")
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  theme       WorkspaceTourTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@index([tenantId, sortOrder, name], map: "idx_workspace_tour_presets_tenant_sort")
  @@map("workspace_tour_presets")
}

/// Phase 9.6 — location regions.
model WorkspaceRegion {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  name         String
  country      String?
  isActive     Boolean                @default(true) @map("is_active")
  sortOrder    Int                    @default(0) @map("sort_order")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destinations WorkspaceDestination[]

  @@index([tenantId, sortOrder, name], map: "idx_workspace_regions_tenant_sort")
  @@map("workspace_regions")
}

/// Phase 9.6 — location destinations.
model WorkspaceDestination {
  id                     String          @id @default(uuid()) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  regionId               String          @map("region_id") @db.Uuid
  name                   String
  locationType           String?         @map("location_type")
  altitudeM              Int?            @map("altitude_m")
  typicalTrailDistanceKm Float?          @map("typical_trail_distance_km")
  isActive               Boolean         @default(true) @map("is_active")
  sortOrder              Int             @default(0) @map("sort_order")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  region                 WorkspaceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([tenantId, regionId, sortOrder, name], map: "idx_workspace_destinations_tenant_region")
  @@map("workspace_destinations")
}

/// Phase 9.6 — settings audit explorer (read-only · R-P9-S13).
model OperatorSettingsAuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at")
  actorUserId  String   @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  summary      String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt(sort: Desc)], map: "idx_operator_settings_audit_tenant_occurred")
  @@map("operator_settings_audit_events")
}

/// Phase 11.2 — per-user workspace draft snapshots (DEC-P11-003).
model WorkspaceDraftSnapshot {
  tenantId        String   @map("tenant_id") @db.Uuid
  workspaceId     String   @map("workspace_id")
  userId          String   @map("user_id") @db.Uuid
  draftNamespace  String   @map("draft_namespace")
  draftKey        String   @map("draft_key")
  schemaVersion   Int      @default(1) @map("schema_version")
  version         Int
  data            Json     @default("{}")
  lastModified    BigInt   @map("last_modified")
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, workspaceId, userId, draftNamespace, draftKey])
  @@index([tenantId, workspaceId, userId], map: "idx_workspace_draft_snapshots_scope")
  @@map("workspace_draft_snapshots")
}

/// Phase 11.9 — append-only audit stream for workspace draft mutations.
model WorkspaceDraftEvent {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  workspaceId    String   @map("workspace_id")
  userId         String   @map("user_id") @db.Uuid
  draftNamespace String   @map("draft_namespace")
  draftKey       String   @map("draft_key")
  action         String
  version        Int?
  schemaVersion  Int      @map("schema_version")
  actorUserId    String   @map("actor_user_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, workspaceId, userId, draftNamespace, draftKey], map: "idx_workspace_draft_events_scope")
  @@map("workspace_draft_events")
}

/// P1-N-053 — Platform-level audit events (no tenantId, for platform ops).
model PlatformAuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("platform_audit_events")
}

/// SK3 BP-7 — tenant-scoped portal member plans (MPS-ENT).
model PortalMemberPlan {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  planCode         String   @map("plan_code")
  displayName      String   @map("display_name")
  moduleGrants     Json     @default("[]") @map("module_grants")
  capabilityFlags  Json     @default("{}") @map("capability_flags")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, planCode], map: "uq_portal_member_plans_tenant_code")
  @@index([tenantId, active], map: "idx_portal_member_plans_tenant_active")
  @@map("portal_member_plans")
}

model PlatformPlan {
  id            String               @id
  displayName   String               @map("display_name")
  priceMonthly  Int?                 @map("price_monthly")
  currency      String               @default("IRR")
  features      Json                 @default("{}")
  createdAt     DateTime             @default(now()) @map("created_at")
  subscriptions TenantSubscription[]

  @@map("platform_plans")
}

model TenantSubscription {
  tenantId         String       @id @map("tenant_id") @db.Uuid
  planId           String       @map("plan_id")
  status           String       @default("active")
  currentPeriodEnd DateTime?    @map("current_period_end") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at")
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan             PlatformPlan @relation(fields: [planId], references: [id])

  @@index([planId], map: "idx_tenant_subscriptions_plan_id")
  @@map("tenant_subscriptions")
}

/// P1-F — custom hostname bindings for club marketing/portal surfaces.
model TenantDomain {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  hostname          String    @unique
  surface           String    @default("marketing")
  status            String    @default("pending")
  cnameTarget       String    @map("cname_target")
  createdAt         DateTime  @default(now()) @map("created_at")
  verifiedAt        DateTime? @map("verified_at")
  sslStatus         String    @default("pending") @map("ssl_status")
  sslExpiresAt      DateTime? @map("ssl_expires_at") @db.Timestamptz
  sslLastError      String?   @map("ssl_last_error")
  lastObservedCname String?   @map("last_observed_cname")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_tenant_domains_tenant_id")
  @@map("tenant_domains")
}

/// P1-G — platform operator directory (phone + role; no password).
model PlatformOpsUser {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @unique
  role      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_ops_users")
}

model WorkspaceTelegramBot {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  workspaceType   String   @map("workspace_type")
  botToken        String   @map("bot_token") @db.VarChar(500)
  channelId       String   @map("channel_id") @db.VarChar(100)
  enabled         Boolean  @default(true)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workspaceType], map: "unique_tenant_workspace_telegram")
  @@index([tenantId], map: "idx_workspace_telegram_bots_tenant")
  @@index([tenantId, workspaceType], map: "idx_workspace_telegram_bots_tenant_workspace")
  @@map("workspace_telegram_bots")
}

/// Workspace integration plugin — tenant-scoped provider connection (replaces provider-specific tables).
model IntegrationConnection {
  id              String                      @id @default(uuid()) @db.Uuid
  tenantId        String                      @map("tenant_id") @db.Uuid
  workspaceType   String?                     @map("workspace_type")
  provider        String
  status          String                      @default("disabled")
  enabled         Boolean                     @default(false)
  capabilities    Json                        @default("[]")
  config          Json                        @default("{}")
  credentials     Json                        @default("{}")
  secretRef       String?                     @map("secret_ref")
  createdByUserId String?                     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventPolicies   IntegrationEventPolicy[]

  @@unique([tenantId, provider, workspaceType], map: "uq_integration_connections_tenant_provider_ws")
  @@index([tenantId, provider, status], map: "idx_integration_connections_tenant_provider_status")
  @@index([tenantId, enabled], map: "idx_integration_connections_tenant_enabled")
  @@map("integration_connections")
}

/// Per-connection domain event routing policy (data-driven dispatcher input).
model IntegrationEventPolicy {
  id                      String                @id @default(uuid()) @db.Uuid
  tenantId                String                @map("tenant_id") @db.Uuid
  integrationConnectionId String                @map("integration_connection_id") @db.Uuid
  eventType               String                @map("event_type")
  enabled                 Boolean               @default(true)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection              IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)

  @@unique([integrationConnectionId, eventType], map: "uq_integration_event_policies_conn_event")
  @@index([tenantId, eventType, enabled], map: "idx_integration_event_policies_tenant_event")
  @@map("integration_event_policies")
}

/// Native Field Exposure profile defaults — persisted enterprise source (Phase 8b).
model ExposureProfile {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  workspaceType     String?  @map("workspace_type")
  profileId         String   @map("profile_id")
  entityType        String   @map("entity_type")
  surface           String
  audience          String
  trigger           String
  defaultFieldIds   Json     @default("[]") @map("default_field_ids")
  defaultTemplateId String?  @map("default_template_id")
  source            String   @default("native")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, profileId], map: "uq_exposure_profiles_tenant_profile")
  @@index([tenantId, workspaceType, surface, audience, trigger], map: "idx_exposure_profiles_context")
  @@map("exposure_profiles")
}

/// Native Field Exposure intent — single authoritative field-selection store (Phase 7i).
model ExposureIntent {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  workspaceType      String?  @map("workspace_type")
  profileId          String   @map("profile_id")
  entityType         String   @map("entity_type")
  surface            String
  audience           String
  trigger            String
  scope              Json     @default("{}")
  scopeHash          String   @map("scope_hash")
  mode               String   @default("inherit_profile")
  selectedFieldIds   Json?    @map("selected_field_ids")
  fieldDecorations   Json?    @map("field_decorations")
  templateOverrideId String?  @map("template_override_id")
  source             String   @default("native")
  createdByUserId    String?  @map("created_by_user_id") @db.Uuid
  updatedByUserId    String?  @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, profileId, surface, audience, trigger, scopeHash], map: "uq_exposure_intents_context_scope")
  @@index([tenantId, workspaceType, profileId], map: "idx_exposure_intents_tenant_ws_profile")
  @@index([tenantId, surface, audience, trigger], map: "idx_exposure_intents_context")
  @@map("exposure_intents")
}

/// Internal secret payload — never exposed via control plane HTTP.
model IntegrationSecret {
  secretRef String   @id @map("secret_ref")
  tenantId  String   @map("tenant_id") @db.Uuid
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_integration_secrets_tenant")
  @@map("integration_secrets")
}

/// Async integration delivery queue — decoupled from outbox relay HTTP path.
model IntegrationDeliveryJob {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  provider      String
  capability    String
  domainEventId String    @map("domain_event_id")
  eventType     String    @map("event_type")
  payload       Json      @default("{}")
  status        String    @default("pending")
  attemptCount  Int       @default(0) @map("attempt_count")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz
  lastError     Json?     @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, capability, domainEventId], map: "uq_integration_delivery_jobs_idempotency")
  @@index([status, nextAttemptAt, createdAt], map: "idx_integration_delivery_jobs_claim")
  @@index([tenantId, status, createdAt], map: "idx_integration_delivery_jobs_tenant_status")
  @@map("integration_delivery_jobs")
}

/// Denali relative-time reminder feed activations — idempotent per tour + offset.
model DenaliExposureReminderActivation {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tourId         String   @map("tour_id") @db.Uuid
  reminderOffset String   @map("reminder_offset")
  anchorAt       DateTime @map("anchor_at") @db.Timestamptz
  activatedAt    DateTime @default(now()) @map("activated_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tourId, reminderOffset], map: "uq_denali_exposure_reminder_activations_idempotency")
  @@index([tenantId, activatedAt(sort: Desc)], map: "idx_denali_exposure_reminder_activations_tenant_activated")
  @@map("denali_exposure_reminder_activations")
}
