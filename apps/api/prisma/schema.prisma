  @@id([tenantId, ticketId, tagCode])
  @@index([tenantId, tagCode], map: "idx_ticket_tag_assignments_tenant_tag")
  @@map("ticket_tag_assignments")
}

/// TKT-001 Phase D1 — tenant-scoped operator queues (persisted filter views).
model TicketQueue {
  id          String    @id @default(uuid()) @db.Uuid
