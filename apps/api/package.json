{
  "name": "@apps/api",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 3.2 thin API — health, POST /tours, CASL-scoped data access (P3-E-DB-01)",
  "main": "./dist/main.js",
  "scripts": {
    "guard:import-boundary": "node ../../scripts/guards/import-boundary-ast.mjs",
    "guard:api-queries": "node ./scripts/guard-no-raw-queries.mjs",
    "guard:id-only-tour-read": "node ./scripts/guard-no-id-only-tour-read.mjs",
    "guard:rls-session-local": "node ./scripts/guard-rls-session-local.mjs",
    "guard:tenant-isolation": "node ./scripts/guard-tenant-isolation.mjs",
    "guard:client-error-log": "node ./scripts/guard-no-client-error-log-co-location.mjs",
    "guard:static-registry": "node ./scripts/guard-static-registry-gate.mjs",
    "audit-boundary": "node ../../scripts/guards/audit-ui-primitives-boundary.mjs",
    "prebuild": "pnpm run guard:import-boundary && pnpm run guard:tenant-isolation && pnpm run guard:client-error-log && pnpm run guard:static-registry",
    "prelint": "pnpm run guard:import-boundary && pnpm run guard:tenant-isolation && pnpm run guard:client-error-log && pnpm run guard:static-registry",
    "pretest": "pnpm run guard:import-boundary && pnpm run guard:tenant-isolation && pnpm run guard:client-error-log && pnpm run guard:static-registry && pnpm run prisma:generate",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "build": "pnpm run prisma:generate && tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test APPS_API_TEST_TIER=trunk node --import tsx --test --test-concurrency=1 \"src/**/*.spec.ts\" \"test/**/*.spec.ts\"",
    "test:nightly": "NODE_ENV=test APPS_API_TEST_TIER=nightly node --import tsx --test --test-concurrency=1 \"src/**/*.spec.ts\" \"test/**/*.spec.ts\"",
    "test:nightly:soak": "NODE_ENV=test RUN_SOAK=1 APPS_API_TEST_TIER=nightly node --expose-gc --import tsx --test --test-concurrency=1 test/3-performance/soak-memory-leak.spec.ts",
    "validate:canonical-sync": "node ./scripts/validate-canonical-sync.mjs",
    "phase-3:api-gate": "pnpm run build && pnpm run test && pnpm run guard:import-boundary && pnpm run guard:tenant-isolation && pnpm run guard:client-error-log && pnpm run guard:static-registry && pnpm run validate:canonical-sync",
    "phase-1:regression-gate": "node ./scripts/phase-1-regression-gate.mjs",
    "db:seed": "NODE_ENV=development tsx scripts/db-seed.ts",
    "test:phase-5": "NODE_ENV=test node --import tsx --test test/phase-5.contract.spec.ts",
    "test:soak": "NODE_ENV=test RUN_SOAK=1 node --expose-gc --import tsx --test --test-concurrency=1 test/3-performance/soak-memory-leak.spec.ts",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@app-tour/platform-core": "workspace:*",
    "@app-tour/platform-events": "workspace:*",
    "@app-tour/tenant-kernel": "workspace:*",
    "@app-tour/workspace-sdk": "workspace:*",
    "@app-tour/workspace-starter": "workspace:*",
    "@casl/ability": "^6.7.3",
    "@prisma/client": "^6.19.0",
    "ioredis": "^5.6.1",
    "jose": "^6.1.0",
    "pino": "^9.6.0",
    "rate-limiter-flexible": "^5.0.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@app-tour/config": "workspace:*",
    "prisma": "^6.19.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
