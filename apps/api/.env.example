# @apps/api — Phase 3.2 scaffold
PORT=3001

# Unsigned dev bearer — ONLY with NODE_ENV=test (CI / node:test). Production/development boot fails if set.
# AUTH_ALLOW_DEV_BEARER=true
# AUTH_DEV_BEARER_TTL_SECONDS=3600

# Phase 3.2b — RS256 session JWT (required when dev bearer is disabled)
# Generate once: cd apps/api && pnpm run bootstrap:dev-jwt >> .env.local
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AUTH_JWT_PUBLIC_KEY_PREVIOUS=  # optional overlap window during rotation (DEC-107)
# AUTH_JWT_ISSUER=tour-ops
# AUTH_JWT_AUDIENCE=tour-ops-api

# Tour storage: memory (default in test) | prisma (default in production)
# memory = non-forensic (no audit_events / outbox SoT) — forbidden when NODE_ENV=production (DEC-045 / AUDIT-GAP-01)
# Phase 5 integration: set prisma when DATABASE_URL is set (see docs/phase-5/appendices/IMPLEMENTATION-DECISIONS.md DEC-010)
# STORAGE_DRIVER=memory
# STORAGE_DRIVER=prisma
# DATABASE_URL=postgresql://app_tour:app_tour@127.0.0.1:5433/app_tour_dev
# DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:5433/app_tour_dev
# Production: app role must be NOBYPASSRLS; admin URL required and must differ (DEC-GAP-03 / DM-CT-02)

# DEC-121 — Prometheus scrape JWT uses AUTH_JWT_* + ops_scope claim metrics:read
# Secret api-metrics-scrape-jwt mounted for ServiceMonitor bearerTokenSecret

# DEC-120 — prod cache invalidate service JWT uses AUTH_JWT_* + ops_scope claim cache:invalidate
# FEATURE_FLAG_FREEZE_DEFAULT_SEC=600
# FEATURE_FLAG_FREEZE_UNTIL=  # ISO-8601 boot-time freeze (optional rollback window)

# DEC-118 — worker split (default api; outbox-relay = background Deployment only)
# WORKER_ROLE=api
# WORKER_ROLE=outbox-relay

# --- Local dev baseline (copy to .env.local; bootstrap-dev-env.ts fills unset flags when DATABASE_URL is set) ---
# DATABASE_URL=postgresql://app_tour:app_tour@127.0.0.1:5434/app_tour_dev
# DATABASE_URL_ADMIN=postgresql://app_tour:app_tour@127.0.0.1:5434/app_tour_dev
# STORAGE_DRIVER=prisma
# OUTBOX_RELAY_ENABLED=true
# INTEGRATION_DELIVERY_ENABLED=true
# INTEGRATION_DELIVERY_WORKER_ENABLED=true
# INTEGRATION_DELIVERY_PROCESSING_RECLAIM_MS=120000

# Phase 5.4 — transactional outbox relay (in-process timer; see IMPLEMENTATION-DECISIONS DEC-004)
# API pods (Rollout): OUTBOX_RELAY_ENABLED=false
# Relay worker Deployment: OUTBOX_RELAY_ENABLED=true + WORKER_ROLE=outbox-relay
# OUTBOX_RELAY_ENABLED=false
# OUTBOX_RELAY_ENABLED=true
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_POLL_BACKOFF_MAX_MS=8000
# OUTBOX_SHUTDOWN_DRAIN_BACKOFF_BASE_MS=50
# OUTBOX_SHUTDOWN_DRAIN_BACKOFF_MAX_MS=500
# HTTP_IDEMPOTENCY_POLL_BASE_MS=25
# HTTP_IDEMPOTENCY_POLL_MAX_MS=500
# CANONICAL_TX_TRANSIENT_RETRY_ATTEMPTS=2
# DB_POOL_SATURATED_RETRY_AFTER_SEC=2
# PRIORITY_LOAD_SHED_ENABLED=true
# GLOBAL_HTTP_INFLIGHT_MAX=64
# GLOBAL_HTTP_LOW_TIER_SHED_WATERMARK=38
# GLOBAL_HTTP_NORMAL_TIER_SHED_WATERMARK=58
# PRIORITY_LOAD_SHED_RETRY_AFTER_SEC=2
# PROJECTION_AUTO_RECONCILE_ENABLED=true
# PROJECTION_AUTO_RECONCILE_INTERVAL_MS=30000
# PROJECTION_AUTO_RECONCILE_BATCH_SIZE=10
# OUTBOX_RELAY_BATCH_SIZE=100
# OUTBOX_RELAY_PUBLISH_CONCURRENCY=16

# In-memory tour caps (RF-SCALE-3)
MAX_TOURS_PER_TENANT=10000
MAX_TOURS_GLOBAL=100000

# Test-only (NODE_ENV=test) — hold open TX for pool saturation perf spec (DEC-012)
# P5_DB_HOLD_MS=200

# Test-only (NODE_ENV=test) — async delay after validateCanonical, before withCanonicalTransaction (DEC-013)
# P5_VALIDATE_DELAY_MS=500

# Validation fairness — scheduler + engine cache (DEC-016; see validation-fairness.md)
# P5_VALIDATION_MAX_CONCURRENT=4
# P5_VALIDATION_ENGINE_CACHE_SIZE=8
# P5_VALIDATION_MAX_IN_FLIGHT_PER_TENANT=2
# P5_VALIDATION_MAX_QUEUE_DEPTH_PER_TENANT=64
# P5_VALIDATION_WORKER_POOL_SIZE=2
# P5_VALIDATION_TIME_BUDGET_MS=10000
# P5_VALIDATION_WORKERS_ENABLED=false

# Per-tenant HTTP rate limit (DEC-015 + Phase 7.6 Redis tier keys)
# See docs/phase-5/appendices/rate-limiting.md · docs/phase-7/subphases/7.6-rate-limits.md
# TENANT_RATE_LIMIT_ENABLED=true
# TENANT_RATE_LIMIT_POINTS=50
# TENANT_RATE_LIMIT_DURATION_SEC=1
# Phase 7.6 — connection-tier RPM caps (pool default; silo >= pool)
# RATE_LIMIT_POOL_RPM=120
# RATE_LIMIT_SILO_RPM=300
# Required in NODE_ENV=production when rate limiting enabled (DEC-065 / SCAL-DEBT-04)
# Local Docker: app-tour-redis on 6379 (pnpm / docker compose up)
REDIS_URL=redis://127.0.0.1:6379

# Phase 7.5 — optional OTLP trace export (DEC-P7-012; logs-only when unset)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=@apps/api

# HTTP ingress body cap (DEC-052 / SCAL-DEBT-03) — reject before JSON.parse
# HTTP_MAX_BODY_BYTES=262144
# HTTP egress response cap (DEC-129 / event-loop P2 #5) — reject before res.end
# HTTP_MAX_RESPONSE_BYTES=2097152
# TENANT_CONFIG_RESPONSE_CACHE_TTL_MS=5000
# HTTP request-log async queue cap (DEC-062 / SCAL-DEBT-07)
# HTTP_LOG_QUEUE_MAX=2048
# Log sink backpressure (DEC-063 / SCAL-DEBT-08)
# LOG_SINK_MIN_LENGTH=4096
# LOG_SINK_MAX_LENGTH=4194304
# LOG_SINK_FLUSH_TIMEOUT_MS=2000

# Per-tenant app-pool TX cap (DEC-055 / SCAL-DEBT-01)
# TENANT_MAX_CONCURRENT_DB_OPS=4
# Concurrent in-flight POST /tours per tenant (DEC-064 / SCAL-DEBT-09)
# TENANT_MAX_CONCURRENT_TOUR_WRITES=8
# Outbox relay in-flight publishes per tenant (DEC-066 / SCAL-DEBT-10)
# OUTBOX_RELAY_MAX_IN_FLIGHT_PER_TENANT=4
# OUTBOX_PROCESSING_RECLAIM_MS=120000
# OUTBOX_MARK_DONE_RETRY_ATTEMPTS=3
# PROXY_UPSTREAM_TIMEOUT_MS=5000
# PROXY_CIRCUIT_FAILURE_THRESHOLD=5
# PROXY_CIRCUIT_OPEN_MS=30000
# Map / enrichment upstream (DEC-093) — unset = /api/v2/map/enrich returns 503
# MAP_UPSTREAM_BASE_URL=https://map-api.example.com
# Memory-driver idempotency bounds — dev/test only (DEC-039 / DEC-067)
# HTTP_IDEMPOTENCY_MEMORY_TTL_MS=300000
# HTTP_IDEMPOTENCY_MEMORY_MAX_ENTRIES=512
# Tenant registry cache max keys per map (DEC-068 / SCAL-DEBT-12)
# TENANT_REGISTRY_CACHE_MAX_ENTRIES=1024

# Compiled cold-start readiness (DEC-061 / SCAL-DEBT-15) — spawn dist/main.js → GET /health
# COLD_START_READINESS_BUDGET_MS=500
# COLD_START_READINESS_SAMPLES=3
# COLD_START_READINESS_ENFORCE=false
# COLD_START_READINESS_TIMEOUT_MS=30000

# Audit actor pseudonym + shared log hashing (DEC-034 / LOG-COL-03)
# AUDIT_PSEUDONYM_KEY=change-me-in-production
# LOG_HASH_KEY=change-me-in-production

# Phase 6.5 — dual validate diff (non-production only; forbidden when NODE_ENV=production)
# SHADOW_VALIDATE_DENALI=false

# Phase 6.7 — MinIO (tenant branding logo + Denali tour photos)
# Start stack: docker compose -f infra/docker-compose.yml up -d minio
# Seed bucket: pnpm run infra:minio:ensure-bucket
# MINIO_ENDPOINT=http://127.0.0.1:9002
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=app-tour-dev

# Marketing catalog cache invalidation (M11 — optional; both required to enable)
# MARKETING_REVALIDATE_URL=http://shop.operator.localhost:3002
# MARKETING_REVALIDATE_SECRET=dev-marketing-revalidate
