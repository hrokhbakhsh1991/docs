# @apps/api — Phase 3.2 scaffold
PORT=3001

# Unsigned dev bearer (`Bearer dev.<base64url(json)>`) — local only
AUTH_ALLOW_DEV_BEARER=true

# Phase 3.2b — RS256 session JWT (required when dev bearer is disabled)
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AUTH_JWT_ISSUER=tour-ops
# AUTH_JWT_AUDIENCE=tour-ops-api

# In-memory tour caps (RF-SCALE-3)
MAX_TOURS_PER_TENANT=10000
MAX_TOURS_GLOBAL=100000
