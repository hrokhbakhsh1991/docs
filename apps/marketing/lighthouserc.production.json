{
  "ci": {
      "collect": {
        "startServerCommand": "node scripts/smoke-marketing-lighthouse-production-servers.mjs",
        "startServerReadyPattern": "production smoke ready",
        "startServerReadyTimeout": 120000,
        "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--host-resolver-rules=MAP operator.localhost 127.0.0.1"
      },
      "url": [
        "http://operator.localhost:3002/",
        "http://operator.localhost:3002/tours"
      ]
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    }
  }
}
