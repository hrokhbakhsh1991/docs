# @apps/marketing — public catalog shell (MAP §3.5)
# Copy to .env.local for overrides (optional in dev — see guest-surface-host resolveTourOpsApiBaseUrl)
ALLOW_DEV_WEB_SESSION=true

# Dev smoke tenant (operator label) — or use denali.localhost:3002 for tenant …000003
TOUR_OPS_DEV_TENANT_ID=00000000-0000-4000-8000-000000000014

# API bridge (server-only)
TOUR_OPS_API_URL=http://127.0.0.1:3001

# PCMS-SEC-02 — copy public verify material from apps/api/.env.local (never AUTH_JWT_PRIVATE_KEY).
# agent-start.sh appends these when missing.
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----\\n"
# AUTH_JWT_ISSUER="tour-ops"
# AUTH_JWT_AUDIENCE="tour-ops-api"

# Catalog upstream cache (seconds; 0 = no cache)
MARKETING_CATALOG_REVALIDATE_SECONDS=60

# Guest bootstrap + branding fetch cache (seconds) — shared M+P via guest-surface-host (M7.1 / M14.1)
GUEST_BOOTSTRAP_REVALIDATE_SECONDS=60
GUEST_BRANDING_REVALIDATE_SECONDS=60
# Legacy alias (still read when GUEST_BRANDING_REVALIDATE_SECONDS unset):
# MARKETING_BRANDING_REVALIDATE_SECONDS=60

# On-demand cache purge (POST /api/revalidate)
# MARKETING_REVALIDATE_SECRET=dev-marketing-revalidate

# User portal registration bridge (WRS — portal.{club}.localhost for M↔P cookie share)
# PORTAL_PUBLIC_BASE_URL=http://portal.denali.localhost:3003
# PORTAL_DEV_PORT=3003

# Cover image optimizer allowlist (M14 — comma-separated hostname or hostname:port)
MARKETING_IMAGE_REMOTE_HOSTS=127.0.0.1:9002
# MARKETING_IMAGES_FORCE_UNOPTIMIZED=true

# SEO robots (dev default: noindex unless true)
# MARKETING_ROBOTS_ALLOW_INDEX=true

# Local / production custom apex (WRS Phase 5 — M↔P cookie Domain=denali.club)
# /etc/hosts: 127.0.0.1 denali.club portal.denali.club admin.denali.club
# MARKETING_PUBLIC_BASE_URL=http://denali.club:3002
# PORTAL_PUBLIC_BASE_URL=http://portal.denali.club:3003
# MARKETING_PUBLIC_BASE_URL=https://denali.club
# PLATFORM_ROOT_DOMAIN=your-platform.example.com
