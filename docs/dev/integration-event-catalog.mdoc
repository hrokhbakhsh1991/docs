## Verification

```bash
# Unit — payload + dispatch merge + TourPublished dispatch idempotency
pnpm --filter @apps/api exec node --import tsx --test \
  src/canonical/build-tour-published-outbox-payload.spec.ts \
  src/integrations/application/resolve-integration-dispatch-payload.spec.ts \
  src/integrations/application/dispatch-integration-domain-event.spec.ts

# Rollout closure (L0)
pnpm --filter @apps/api exec node --import tsx --test \
  test/tour-published-rollout-closure.contract.spec.ts

# Web — event list + load warning partition
pnpm --filter @apps/web exec node --import tsx --test \
  test/build-exposure-event-type-list.spec.ts \
  test/integration-connection-load-warnings.spec.ts

# Integration L2/L3 — outbox + dispatch (DATABASE_URL)
export DATABASE_URL='postgresql://app_tour:app_tour@127.0.0.1:5434/app_tour_dev'
export DATABASE_URL_ADMIN="$DATABASE_URL"
pnpm --filter @apps/api run db:migrate:deploy
STORAGE_DRIVER=prisma NODE_ENV=test \
  pnpm --filter @apps/api exec node --import tsx --test \
  test/4-integration/tour-published-outbox.spec.ts
```
