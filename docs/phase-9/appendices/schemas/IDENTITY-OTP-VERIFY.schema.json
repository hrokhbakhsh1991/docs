{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-tour.dev/schemas/identity-otp-verify.json",
  "title": "IdentityOtpVerifyRequest",
  "description": "POST /auth/verify-otp body — Phase 9.1 (legacy web/session/otp parity)",
  "type": "object",
  "additionalProperties": false,
  "required": ["mobile", "code"],
  "properties": {
    "mobile": {
      "type": "string",
      "pattern": "^\\+[1-9]\\d{6,14}$",
      "description": "E.164 — BFF maps login-web-session phone field"
    },
    "code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 8,
      "description": "OTP verification code"
    },
    "challengeId": {
      "type": "string",
      "format": "uuid",
      "description": "Optional in dev static OTP; required in prod"
    },
    "inviteToken": {
      "type": "string",
      "description": "Optional invite_token from login query"
    }
  }
}
