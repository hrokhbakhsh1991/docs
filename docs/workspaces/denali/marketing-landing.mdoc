## 27. Reference stubs (v6 — SDK-first)

### 27.1 `render-home-page.tsx`

```typescript
import { resolveGuestLandingFeatures } from "@app-tour/workspace-sdk";
import { GuestHomeFull } from "./guest-home-full";
import { GuestHomeMinimal } from "./guest-home-minimal";

export function renderHomePage(input: {
  landing: ReturnType<typeof resolveGuestLandingFeatures>;
  branding: PublicTenantBrandingSnapshot;
  catalogItems: readonly CatalogListItem[];
  pluginId: string;
}) {
  if (input.landing.variant === "full") {
    return (
      <GuestHomeFull
        landing={input.landing}
        branding={input.branding}
        catalogItems={input.catalogItems}
        pluginId={input.pluginId}
      />
    );
  }
  return <GuestHomeMinimal branding={input.branding} landing={input.landing} />;
}
```

### 27.2 `guest-home-full.tsx`

```typescript
export function GuestHomeFull({ landing, branding, catalogItems, pluginId }) {
  const sections = resolveHomeSectionVisibility(landing, catalogItems.length, categories.length);
  return (
    <main data-marketing-home>
      {sections.hero ? <HomeHero branding={branding} showSearch={sections.heroSearch} /> : null}
      {sections.featured ? <HomeFeatured items={featuredSlice} pluginId={pluginId} /> : null}
      {sections.latest ? <HomeLatestTours items={latestSlice} pluginId={pluginId} /> : null}
      {sections.categories ? <HomeCategories categories={derived} /> : null}
      {sections.destinations ? <HomeDestinations /> : null}
      {landing.sections.trust ? <HomeTrust branding={branding} profile="full" /> : null}
      {landing.sections.finalCta ? <HomeFinalCta profile="full" /> : null}
    </main>
  );
}
```

