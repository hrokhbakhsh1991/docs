```yaml
doc_id: DENALI-MARKETING-LANDING-VISUAL
version: "2026-07-04-v1"
status: ACTIVE
phase: PR-4 (visual only — after PR-0..3 engineering)
route: /
apps: [marketing]
workspace_skin: denali
skill_upstream: https://github.com/nextlevelbuilder/ui-ux-pro-max-skill
