{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-tour.local/schemas/workspace-manifest/v1",
  "title": "WorkspaceManifest",
  "description": "Phase 10 — per-package discovery manifest for plugin host codegen (DEC-P10-001).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "package", "workspaceTypes", "plugin"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable plugin id; must match WorkspacePlugin.id"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Manifest schema revision (not npm semver)"
    },
    "package": {
      "type": "string",
      "pattern": "^@app-tour/workspace-[a-z][a-z0-9-]*$",
      "description": "pnpm workspace package name"
    },
    "workspaceTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true,
      "description": "tenant.workspace_type values bound to this plugin"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "export"],
      "properties": {
        "entry": {
          "type": "string",
          "description": "package.json exports subpath (e.g. ./plugin or .)"
        },
        "export": {
          "type": "string",
          "description": "Named export returning WorkspacePlugin singleton"
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "description": "package exports subpath for dynamic import in apps/web"
        },
        "export": {
          "type": "string",
          "description": "Named export (e.g. getDenaliWorkspacePlugin)"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventType", "module", "export"],
        "properties": {
          "eventType": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "description": "Relative path under package src (Phase 11+); Phase 1 may use host adapter"
          },
          "export": {
            "type": "string"
          },
          "workspaceTypes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional filter; omit = all supportedWorkspaceTypes"
          }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "description": "Relative module exporting WorkspaceHttpRoute[] (Phase 3+)"
        },
        "prefix": {
          "type": "string",
          "pattern": "^/[a-z0-9/-]*$",
          "description": "Optional URL prefix for documentation; routes carry full paths"
        }
      }
    },
    "tourWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "workspaceTypeExport", "mergeExport", "publishGateExport", "publishSurfaceExport"],
      "properties": {
        "module": {
          "type": "string",
          "description": "Package subpath exporting tour PATCH hooks (e.g. ./tours)"
        },
        "workspaceTypeExport": {
          "type": "string",
          "description": "Named const export for workspace type id (e.g. URBAN_WORKSPACE_TYPE)"
        },
        "mergeExport": {
          "type": "string",
          "description": "Deep-merge canonical patch for workspace"
        },
        "publishGateExport": {
          "type": "string",
          "description": "Returns true when PATCH touches owner-gated publish fields"
        },
        "publishSurfaceExport": {
          "type": "string",
          "description": "CASL surface id string export for owner gate"
        }
      }
    },
    "pluginApiVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Host plugin API contract version (Phase 14)"
    },
    "wizardSurfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surfaceId": {
          "type": "string",
          "description": "Opaque surface id matching wizardHost compositeSurfaceId / reviewSurfaceId"
        },
        "composite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["webModule", "export"],
          "properties": {
            "webModule": { "type": "string" },
            "export": { "type": "string" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["webModule", "export"],
          "properties": {
            "webModule": { "type": "string" },
            "export": { "type": "string" }
          }
        }
      }
    },
    "wizardI18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageNamespace"],
      "properties": {
        "messageNamespace": { "type": "string" },
        "labelResolver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["webModule", "export"],
          "properties": {
            "webModule": { "type": "string" },
            "export": { "type": "string" }
          }
        }
      }
    },
    "wizardCloneRemint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "workspaceTypeExport",
        "executeRemintExport",
        "assertDestKeyExport",
        "readConfigExport"
      ],
      "properties": {
        "module": { "type": "string" },
        "workspaceTypeExport": { "type": "string" },
        "executeRemintExport": { "type": "string" },
        "assertDestKeyExport": { "type": "string" },
        "readConfigExport": { "type": "string" },
        "serverRemintModule": {
          "type": "string",
          "description": "Module for server-side tour clone canonical photo remint planner"
        },
        "remintCanonicalExport": {
          "type": "string",
          "description": "Export that remints clone photos in canonical data (server cloneTour path)"
        },
        "executeTourRemintExport": {
          "type": "string",
          "description": "Export that executes tour photo remint plan (usually in photos module)"
        }
      }
    },
    "wizardCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extendedChrome": {
          "type": "boolean",
          "description": "When true, route to workspace-specific create chrome client"
        }
      }
    },
    "wizardMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "workspaceTypeExport",
        "maxUploadBytesExport",
        "isSessionIdExport",
        "isDraftReadKeyAllowedExport",
        "putDraftPhotoExport",
        "getSignedReadUrlExport",
        "ensureBucketExport",
        "readConfigExport"
      ],
      "properties": {
        "module": {
          "type": "string",
          "description": "Package subpath exporting wizard draft photo hooks (e.g. ./photos)"
        },
        "workspaceTypeExport": {
          "type": "string",
          "description": "Named const export for workspace type id"
        },
        "maxUploadBytesExport": {
          "type": "string",
          "description": "Max upload body size for wizard draft photos"
        },
        "isSessionIdExport": {
          "type": "string",
          "description": "Validates X-Wizard-Session-Id and X-Photo-Id headers"
        },
        "isDraftReadKeyAllowedExport": {
          "type": "string",
          "description": "Returns true when storageKey is readable for tenant wizard draft"
        },
        "putDraftPhotoExport": {
          "type": "string",
          "description": "Upload provisional wizard draft photo to object storage"
        },
        "getSignedReadUrlExport": {
          "type": "string",
          "description": "Signed GET URL for a storage key"
        },
        "ensureBucketExport": {
          "type": "string",
          "description": "Ensure MinIO bucket exists before upload/read"
        },
        "readConfigExport": {
          "type": "string",
          "description": "Read object storage config from env (null when unset)"
        }
      }
    }
  }
}
