{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-tour.local/schemas/workspace-manifest/v1",
  "title": "WorkspaceManifest",
  "description": "Phase 10 — per-package discovery manifest for plugin host codegen (DEC-P10-001).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "package", "workspaceTypes", "plugin"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable plugin id; must match WorkspacePlugin.id"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Manifest schema revision (not npm semver)"
    },
    "package": {
      "type": "string",
      "pattern": "^@app-tour/workspace-[a-z][a-z0-9-]*$",
      "description": "pnpm workspace package name"
    },
    "workspaceTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true,
      "description": "tenant.workspace_type values bound to this plugin"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "export"],
      "properties": {
        "entry": {
          "type": "string",
          "description": "package.json exports subpath (e.g. ./plugin or .)"
        },
        "export": {
          "type": "string",
          "description": "Named export returning WorkspacePlugin singleton"
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "description": "package exports subpath for dynamic import in apps/web"
        },
        "export": {
          "type": "string",
          "description": "Named export (e.g. getDenaliWorkspacePlugin)"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventType", "module", "export"],
        "properties": {
          "eventType": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "description": "Relative path under package src (Phase 11+); Phase 1 may use host adapter"
          },
          "export": {
            "type": "string"
          },
          "workspaceTypes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional filter; omit = all supportedWorkspaceTypes"
          },
          "hostSideEffect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapterModule", "export"],
            "properties": {
              "adapterModule": {
                "type": "string",
                "description": "Host adapter module under package (maps to @pkg/host/*)"
              },
              "export": {
                "type": "string",
                "description": "Side-effect runner export (e.g. runTourCreatedFinanceSideEffect)"
              },
              "registerExport": {
                "type": "string",
                "description": "Boot-time deps registrar (e.g. registerTourCreatedFinanceSideEffectDeps)"
              },
              "rowTypeExport": {
                "type": "string",
                "description": "Row type re-export for outbox processors"
              }
            }
          }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "description": "Relative module exporting WorkspaceHttpRoute[] (Phase 3+)"
        },
        "prefix": {
          "type": "string",
          "pattern": "^/[a-z0-9/-]*$",
          "description": "Optional URL prefix for documentation; routes carry full paths"
        }
      }
    },
    "tourWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "workspaceTypeExport", "mergeExport", "publishGateExport", "publishSurfaceExport"],
      "properties": {
        "module": {
          "type": "string",
          "description": "Package subpath exporting tour PATCH hooks (e.g. ./tours)"
        },
        "workspaceTypeExport": {
          "type": "string",
          "description": "Named const export for workspace type id (e.g. URBAN_WORKSPACE_TYPE)"
        },
        "mergeExport": {
          "type": "string",
          "description": "Deep-merge canonical patch for workspace"
        },
        "publishGateExport": {
          "type": "string",
          "description": "Returns true when PATCH touches owner-gated publish fields"
        },
        "publishSurfaceExport": {
          "type": "string",
          "description": "CASL surface id string export for owner gate"
        },
        "forbidOperatorMemberTourPatch": { "type": "boolean" },
        "starterCreateBridgeOperatorTenantId": {
          "type": "string",
          "description": "Operator smoke tenant UUID for starter-shaped create bridge (WAC-001)"
        },
        "publishOwnerAssertModule": { "type": "string" },
        "publishOwnerAssertExport": { "type": "string" }
      }
    },
    "canonicalTour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publishStatusModule": { "type": "string" },
        "publishStatusReadExport": { "type": "string" },
        "publishTransitionExport": { "type": "string" },
        "migrateModule": { "type": "string" },
        "migrateExport": { "type": "string" },
        "formProfileGhostPathsModule": { "type": "string" },
        "formProfileGhostPathsExport": { "type": "string" },
        "validationSyncOnly": { "type": "boolean" },
        "catalogRefEnrichment": { "type": "boolean" }
      }
    },
    "workspaceFinance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": { "type": "boolean" },
        "defaultModuleEnabledWhenUnset": { "type": "boolean" },
        "registryOnly": {
          "type": "boolean",
          "description": "When true, emit finance dependency bindings only — exclude from plugin/SDK/web registries and nav/gate (fixture packages)."
        },
        "ledgerPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "export"],
          "properties": {
            "module": { "type": "string" },
            "export": { "type": "string" }
          }
        },
        "receiptDefaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "export"],
          "properties": {
            "module": { "type": "string" },
            "export": { "type": "string" }
          }
        },
        "chartOfAccounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "export"],
          "description": "Workspace chart-of-accounts constant (required with ledgerPolicy). Consumed by policy adapters; codegen emits audit/resolve bindings.",
          "properties": {
            "module": { "type": "string" },
            "export": { "type": "string" }
          }
        },
        "eventReaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "export"],
          "properties": {
            "module": { "type": "string" },
            "export": { "type": "string" },
            "requiresHostIo": { "type": "boolean" }
          }
        },
        "opsManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "defaultExport", "resolveFromThemeExport"],
          "properties": {
            "module": { "type": "string" },
            "defaultExport": { "type": "string" },
            "resolveFromThemeExport": { "type": "string" }
          }
        }
      }
    },
    "integrationCapabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tourPublishedPolicyDriftCheck": { "type": "boolean" },
          "tourPublishedExposureRemap": { "type": "boolean" },
          "deprecatedEventTypes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["eventType", "supersededBy"],
              "properties": {
                "eventType": { "type": "string" },
                "supersededBy": { "type": "string" }
              }
            }
          },
          "deliveryReferenceDisplayFieldIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "wizardTemplateEnforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "assertFrozenFieldsExport", "normalizeStepsExport"],
      "properties": {
        "module": { "type": "string" },
        "assertFrozenFieldsExport": { "type": "string" },
        "normalizeStepsExport": { "type": "string" }
      }
    },
    "wizardTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathAliases", "aliasCatalogWorkspaceType"],
      "properties": {
        "pathAliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Canonical paths accepted via aliasCatalogWorkspaceType catalog (starter bridge)"
        },
        "aliasCatalogWorkspaceType": {
          "type": "string",
          "description": "Workspace type whose field registry validates aliased paths"
        }
      }
    },
    "exposureHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": { "type": "string" },
        "surfaceDefaultFieldIdsExport": { "type": "string" },
        "mapSurfaceToFieldPolicyExport": { "type": "string" },
        "reminderOffsetsExport": { "type": "string" },
        "exposureCoordinateTypeExport": { "type": "string" }
      }
    },
    "pluginApiVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Host plugin API contract version (Phase 14)"
    },
    "wizardSurfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surfaceId": {
          "type": "string",
          "description": "Opaque surface id matching wizardHost compositeSurfaceId / reviewSurfaceId"
        },
        "composite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["webModule", "export"],
          "properties": {
            "webModule": { "type": "string" },
            "export": { "type": "string" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["webModule", "export"],
          "properties": {
            "webModule": { "type": "string" },
            "export": { "type": "string" }
          }
        }
      }
    },
    "wizardI18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageNamespace"],
      "properties": {
        "messageNamespace": { "type": "string" },
        "labelResolver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["webModule", "export"],
          "properties": {
            "webModule": { "type": "string" },
            "export": { "type": "string" }
          }
        }
      }
    },
    "wizardCloneRemint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "workspaceTypeExport",
        "executeRemintExport",
        "assertDestKeyExport",
        "readConfigExport"
      ],
      "properties": {
        "module": { "type": "string" },
        "workspaceTypeExport": { "type": "string" },
        "executeRemintExport": { "type": "string" },
        "assertDestKeyExport": { "type": "string" },
        "readConfigExport": { "type": "string" },
        "serverRemintModule": {
          "type": "string",
          "description": "Module for server-side tour clone canonical photo remint planner"
        },
        "remintCanonicalExport": {
          "type": "string",
          "description": "Export that remints clone photos in canonical data (server cloneTour path)"
        },
        "executeTourRemintExport": {
          "type": "string",
          "description": "Export that executes tour photo remint plan (usually in photos module)"
        }
      }
    },
    "wizardCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extendedChrome": {
          "type": "boolean",
          "description": "When true, route to workspace-specific create chrome client"
        }
      }
    },
    "wizardMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "workspaceTypeExport",
        "maxUploadBytesExport",
        "isSessionIdExport",
        "isDraftReadKeyAllowedExport",
        "putDraftPhotoExport",
        "getSignedReadUrlExport",
        "ensureBucketExport",
        "readConfigExport"
      ],
      "properties": {
        "module": {
          "type": "string",
          "description": "Package subpath exporting wizard draft photo hooks (e.g. ./photos)"
        },
        "workspaceTypeExport": {
          "type": "string",
          "description": "Named const export for workspace type id"
        },
        "maxUploadBytesExport": {
          "type": "string",
          "description": "Max upload body size for wizard draft photos"
        },
        "isSessionIdExport": {
          "type": "string",
          "description": "Validates X-Wizard-Session-Id and X-Photo-Id headers"
        },
        "isDraftReadKeyAllowedExport": {
          "type": "string",
          "description": "Returns true when storageKey is readable for tenant wizard draft"
        },
        "putDraftPhotoExport": {
          "type": "string",
          "description": "Upload provisional wizard draft photo to object storage"
        },
        "getSignedReadUrlExport": {
          "type": "string",
          "description": "Signed GET URL for a storage key"
        },
        "ensureBucketExport": {
          "type": "string",
          "description": "Ensure MinIO bucket exists before upload/read"
        },
        "readConfigExport": {
          "type": "string",
          "description": "Read object storage config from env (null when unset)"
        }
      }
    },
    "wizardTemplateGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultPublishedStepId"],
      "properties": {
        "defaultPublishedStepId": {
          "type": "string",
          "minLength": 1,
          "description": "Default wizard template step id when publishing with zero selected fields"
        },
        "fieldOverlaysAugment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "export"],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "description": "Package subpath for hidden composite template overlay augment (maps to @pkg/host/*)"
            },
            "export": {
              "type": "string",
              "minLength": 1,
              "description": "Augment function export (e.g. augmentDenaliWizardTemplateFieldOverlays)"
            }
          }
        },
        "preferTemplateDefaultsOnPrefill": {
          "type": "boolean",
          "description": "When true, template defaultValue overwrites non-empty draft paths on create prefill"
        }
      }
    }
  }
}
