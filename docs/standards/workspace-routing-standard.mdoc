pnpm --filter @apps/portal run test:smoke:custom-apex  # SMK-PTL-08
node scripts/smoke-p6-host-bind.mjs
pnpm run seed:wrs-denali-club-domains   # dev Postgres
pnpm run smoke:wrs-custom-apex          # denali.club + portal + admin (memory: WRS_SMOKE_CUSTOM_APEX=1)
pnpm run smoke:pcms-custom-apex
pnpm run guard:wrs-routing
pnpm run guard:wrs-stale-docs
pnpm run guard:pcms-authority
pnpm run guard:surface-cohesion
pnpm run phase-psc:fast-track   # PSC-001 closure — guard + smoke + strict
pnpm run test:changed
```

