  },
  "description": "Finance production SLOs (Phase 3.18) — FINANCE_SLO_FRAMEWORK.md",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "SLO framework",
      "url": "https://github.com/app-cloud/docs/blob/main/docs/phase-20/p7/appendices/FINANCE_SLO_FRAMEWORK.md"
    },
    {
      "title": "Runbook",
      "url": "https://github.com/app-cloud/docs/blob/main/docs/phase-20/p7/appendices/FINANCE-OPS-RUNBOOK.md"
    }
  ],
  "panels": [
    {
      "title": "SLO-F1 Approve availability (30d)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(finance_approve_total{namespace=\"app-cloud\",result=\"success\"}[30d])) / clamp_min(sum(increase(finance_approve_total{namespace=\"app-cloud\",result=~\"success|failure\"}[30d])), 1)",
          "legendFormat": "availability",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.999 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      },
      "id": 1
    },
    {
      "title": "SLO-F1 Error budget remaining (proxy)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "clamp_min(0.001 - (1 - (sum(increase(finance_approve_total{namespace=\"app-cloud\",result=\"success\"}[30d])) / clamp_min(sum(increase(finance_approve_total{namespace=\"app-cloud\",result=~\"success|failure\"}[30d])), 1))), 0) / 0.001",
          "legendFormat": "budget_remaining",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      },
      "id": 2
    },
    {
      "title": "Approve results (15m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (result) (increase(finance_approve_total{namespace=\"app-cloud\"}[15m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "title": "SLO-F2/F3/F4 Last latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "max(finance_payment_latency_ms{namespace=\"app-cloud\"})",
          "legendFormat": "payment",
          "refId": "A"
        },
        {
          "expr": "max(finance_approve_latency_ms{namespace=\"app-cloud\"})",
          "legendFormat": "approve",
          "refId": "B"
        },
        {
          "expr": "max(finance_ledger_latency_ms{namespace=\"app-cloud\"})",
          "legendFormat": "ledger",
          "refId": "C"
        }
      ],
      "id": 4
    },
    {
      "title": "Latency budget exceeded (15m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (operation) (increase(finance_latency_budget_exceeded_total{namespace=\"app-cloud\"}[15m]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "title": "SLO-F5 Outbox lag (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "finance_outbox_oldest_pending_age_seconds{namespace=\"app-cloud\"}",
          "legendFormat": "oldest_pending_age",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "title": "SLO-F6 Replay duration (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "max by (mode, dry_run) (outbox_replay_duration_ms{namespace=\"app-cloud\"})",
          "legendFormat": "{{mode}} dry={{dry_run}}",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "title": "SLO-F7 Consistency gauges",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "finance_reconciliation_mismatch{namespace=\"app-cloud\"}",
          "legendFormat": "paid_without_ledger",
          "refId": "A"
        },
        {
          "expr": "finance_recon_findings_open{namespace=\"app-cloud\"}",
          "legendFormat": "recon_findings_open",
          "refId": "B"
        },
        {
          "expr": "finance_stuck_payments{namespace=\"app-cloud\"}",
          "legendFormat": "stuck_payments",
          "refId": "C"
        }
      ],
      "id": 8
    },
    {
      "title": "Ledger capture results (15m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum by (result) (increase(finance_ledger_capture_total{namespace=\"app-cloud\"}[15m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
      "title": "Replay events (15m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(outbox_replay_events_total{namespace=\"app-cloud\"}[15m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "id": 10
    }
  ],
  "schemaVersion": 39,
  "tags": ["finance", "slo", "app-cloud"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
