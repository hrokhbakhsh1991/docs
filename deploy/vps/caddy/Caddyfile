# Caddyfile — Profile C HTTPS (P10-1-N-001)
# Env: production and staging ports from /etc/caddy/caddy.env.
# Arvan terminates public HTTPS. The origin stays HTTP while applications must
# still receive X-Forwarded-Proto=https to avoid secure-session redirect loops.

{
	email {$CADDY_ACME_EMAIL:ops@example.com}
	admin off
}

http://*.admin.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$WEB_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/admin-access.log
		format json
	}
}

# Canonical sibling host: admin.{club}.{root}; the wildcard above keeps the
# legacy {club}.admin.{root} address working during migration.
http://admin.{$CANONICAL_TENANT_LABEL}.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$WEB_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/admin-access.log
		format json
	}
}

# Isolated staging stack. Exact host match must win over the marketing wildcard.
http://staging-admin-{$CANONICAL_TENANT_LABEL}.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$STAGING_WEB_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/admin-access.log
		format json
	}
}

http://*.portal.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$PORTAL_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/portal-access.log
		format json
	}
}

# Canonical portal host comes from PORTAL_PUBLIC_BASE_URL and may be a custom
# apex such as portal.denali.club; the wildcard above keeps the legacy
# {club}.portal.{root} address working during migration.
http://{$CANONICAL_PORTAL_HOST} {
	reverse_proxy 127.0.0.1:{$PORTAL_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/portal-access.log
		format json
	}
}

http://staging-portal-{$CANONICAL_TENANT_LABEL}.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$STAGING_PORTAL_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/portal-access.log
		format json
	}
}

# Public HTTPS origin for browser-reachable MinIO presigned URLs. Arvan
# terminates TLS; Caddy forwards the request to loopback MinIO without
# exposing port 9002 or an IP address to the browser.
http://{$MINIO_PUBLIC_HOST} {
	reverse_proxy 127.0.0.1:{$MINIO_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/minio-access.log
		format json
	}
}

http://*.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$MARKETING_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/marketing-access.log
		format json
	}
}

http://staging-{$CANONICAL_TENANT_LABEL}.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$STAGING_MARKETING_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/marketing-access.log
		format json
	}
}

# Public API endpoint for Telegram webhooks and external integrations.
http://api.{$PLATFORM_ROOT_DOMAIN} {
    reverse_proxy 127.0.0.1:{$API_PORT} {
        header_up Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {remote_host}
    }

    log {
        output file /var/log/caddy/api-access.log
        format json
    }
}
