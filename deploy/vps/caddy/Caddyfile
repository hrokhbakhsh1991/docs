# Caddyfile — Profile C HTTPS (P10-1-N-001)
# Env: PLATFORM_ROOT_DOMAIN, WEB_PORT, MARKETING_PORT, PORTAL_PORT (from /etc/caddy/caddy.env)
# Staging example: WEB_PORT=23000 MARKETING_PORT=23002 PORTAL_PORT=23003
# Arvan terminates public HTTPS. The origin stays HTTP while applications must
# still receive X-Forwarded-Proto=https to avoid secure-session redirect loops.

{
	email {$CADDY_ACME_EMAIL:ops@example.com}
	admin off
}

http://*.admin.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$WEB_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/admin-access.log
		format json
	}
}

# Canonical sibling host: admin.{club}.{root}; the wildcard above keeps the
# legacy {club}.admin.{root} address working during migration.
http://admin.{$CANONICAL_TENANT_LABEL}.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$WEB_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/admin-access.log
		format json
	}
}

http://*.portal.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$PORTAL_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/portal-access.log
		format json
	}
}

# Canonical sibling host: portal.{club}.{root}; the wildcard above keeps the
# legacy {club}.portal.{root} address working during migration.
http://portal.{$CANONICAL_TENANT_LABEL}.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$PORTAL_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/portal-access.log
		format json
	}
}

http://*.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy 127.0.0.1:{$MARKETING_PORT} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/marketing-access.log
		format json
	}
}

# Public API endpoint for Telegram webhooks and external integrations.
http://api.{$PLATFORM_ROOT_DOMAIN} {
    reverse_proxy 127.0.0.1:{$API_PORT} {
        header_up Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {remote_host}
    }

    log {
        output file /var/log/caddy/api-access.log
        format json
    }
}
