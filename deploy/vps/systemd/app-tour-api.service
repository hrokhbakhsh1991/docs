[Unit]
Description=App Tour API (@apps/api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@DEPLOY_PATH@
EnvironmentFile=@ENV_DIR@/api.env
Environment=DEPLOY_PATH=@DEPLOY_PATH@
Environment=ENV_DIR=@ENV_DIR@
ExecStart=@DEPLOY_PATH@/scripts/vps-deploy/start-api.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
