[Unit]
Description=App Tour Operator Web (@apps/web)
After=network-online.target app-tour-api.service
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@DEPLOY_PATH@
EnvironmentFile=@ENV_DIR@/web.env
ExecStart=/usr/bin/corepack pnpm --filter @apps/web exec next start --port 3000 --hostname 0.0.0.0
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
