[Unit]
Description=App Tour Marketing (@apps/marketing)
After=network-online.target app-tour-api.service
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@DEPLOY_PATH@
EnvironmentFile=@ENV_DIR@/marketing.env
Environment=DEPLOY_PATH=@DEPLOY_PATH@
Environment=ENV_DIR=@ENV_DIR@
ExecStart=@DEPLOY_PATH@/scripts/vps-deploy/start-marketing.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
