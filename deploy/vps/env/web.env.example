# /etc/app-tour/web.env — operator admin web (BFF → local API)
NODE_ENV=production
PORT=3000
# Bind all interfaces (do not use shell HOSTNAME — that is the machine name, not 0.0.0.0)
WEB_BIND_HOST=0.0.0.0

# BFF talks to API on the same host — PORT must match /etc/app-tour/api.env PORT
# remote-deploy runs sync-web-api-url-port.sh to keep these aligned.
TOUR_OPS_API_URL=http://127.0.0.1:3001
API_INTERNAL_URL=http://127.0.0.1:3001

# Optional non-default public ports (e.g. firewall uses 13000/13001 instead of 3000/3001):
# Set PORT in BOTH env files, then ufw allow those ports. Example:
#   api.env:  PORT=13001
#   web.env:  PORT=13000  (+ TOUR_OPS_API_URL=http://127.0.0.1:13001)

# Public access via IP (no domain yet) — adjust when DNS lands
# Users open: http://YOUR_VPS_IP:3000
ALLOW_DENALI_WEB_PLUGIN=true
ALLOW_URBAN_WEB_PLUGIN=true

# Profile C (P10): set true when Caddy HTTPS edge is active
# SESSION_COOKIE_SECURE=true
# PLATFORM_ROOT_DOMAIN=staging.example.com

# HTTP staging without TLS — must be false or login cookies are dropped by the browser
SESSION_COOKIE_SECURE=false

# Raw IP staging — must match api.env PUBLIC_TENANT_FALLBACK_* and tenant registry label
# TOUR_OPS_DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000003
# TOUR_OPS_PUBLIC_FALLBACK_HOSTS=89.45.89.206,127.0.0.1

# Must match api.env public key — BFF middleware verifies session JWT (RS256) before protected /api/*.
# Copy AUTH_JWT_PUBLIC_KEY, AUTH_JWT_ISSUER, AUTH_JWT_AUDIENCE from /etc/app-tour/api.env (never the private key).
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AUTH_JWT_ISSUER=tour-ops
# AUTH_JWT_AUDIENCE=tour-ops-api
