# /etc/app-tour/portal.env — member register + /me (P7-0 three-surface staging)
NODE_ENV=production
PORT=3003
WEB_BIND_HOST=0.0.0.0

TOUR_OPS_API_URL=http://127.0.0.1:3001

# HTTPS staging behind Caddy/Arvan
SESSION_COOKIE_SECURE=true
# MARKETING_PUBLIC_BASE_URL=https://denali.shenski.com
# Profile C (P10): set true when portal served via https://portal.{club}.{root}

# JWT verify for member session BFF — copy from api.env (public key only)
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AUTH_JWT_ISSUER=tour-ops
# AUTH_JWT_AUDIENCE=tour-ops-api

# Portal SSR self-fetch loopback (staging Profile B)
# PORTAL_INTERNAL_URL=http://127.0.0.1:23003

# Member profile contract snapshot (standalone artifact layout — auto-resolved when unset)
# MEMBER_PROFILE_CONTRACT_SNAPSHOT_PATH=/opt/app-tour-staging/current/portal/apps/portal/src/me/member-profile-contract-v1.snapshot.json

# Raw IP staging fallback (until portal.{club}.{root} DNS)
# TOUR_OPS_PUBLIC_FALLBACK_HOSTS=89.42.210.252
# PLATFORM_ROOT_DOMAIN=shenski.com
