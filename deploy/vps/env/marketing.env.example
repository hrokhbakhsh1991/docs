# /etc/app-tour/marketing.env — public catalog (P7-0 three-surface staging)
NODE_ENV=production
PORT=3002
WEB_BIND_HOST=0.0.0.0

# BFF → API on same host (PORT must match api.env)
TOUR_OPS_API_URL=http://127.0.0.1:3001

# CTA links to portal registration (subdomain staging)
# PORTAL_PUBLIC_BASE_URL=https://operator.portal.staging.example.com
# Dev canonical: http://operator.portal.localhost:3003

# Optional ISR
# MARKETING_CATALOG_REVALIDATE_SECONDS=60

# Required for publish → catalog revalidate (must match api.env MARKETING_REVALIDATE_SECRET)
MARKETING_REVALIDATE_SECRET=CHANGE_ME_SAME_AS_API_ENV

# Profile C (P10): SESSION_COOKIE_SECURE=true when behind Caddy HTTPS
# SESSION_COOKIE_SECURE=false

# Raw IP staging — match api.env PUBLIC_TENANT_FALLBACK_* until DNS
# PUBLIC_TENANT_FALLBACK_LABEL=denali
# PUBLIC_TENANT_FALLBACK_HOSTS=89.45.89.206,127.0.0.1
# TOUR_OPS_PUBLIC_FALLBACK_HOSTS=89.45.89.206

# MinIO presigned catalog covers (staging public port)
# MARKETING_IMAGE_REMOTE_HOSTS=YOUR_VPS_IP:9002
