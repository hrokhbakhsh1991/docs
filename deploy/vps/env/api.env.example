# /etc/app-tour/api.env — production API (VPS local Postgres/Redis/MinIO)
NODE_ENV=production
PORT=3001
STORAGE_DRIVER=prisma

# Postgres on VPS (native :5433 — not the dev SSH tunnel ports)
DATABASE_URL=postgresql://app_tour:CHANGE_ME@127.0.0.1:5433/tour_db?connection_limit=32
DATABASE_URL_ADMIN=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/tour_db?connection_limit=8

REDIS_URL=redis://127.0.0.1:6379
TENANT_RATE_LIMIT_ENABLED=true
OUTBOX_RELAY_ENABLED=false

# MinIO on VPS
MINIO_ENDPOINT=http://127.0.0.1:9002
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=app-tour-prod

# RS256 JWT — generate: cd apps/api && pnpm run bootstrap:dev-jwt
AUTH_JWT_ISSUER=tour-ops
AUTH_JWT_AUDIENCE=tour-ops-api
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional dev OTP until SMS (remove in real production)
# AUTH_ALLOW_DEV_STATIC_OTP=true
# OPERATOR_OWNER_MOBILE=+989121000001
