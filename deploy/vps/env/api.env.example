# /etc/app-tour/api.env — production API (VPS local Postgres/Redis/MinIO)
NODE_ENV=production
APP_INFRA_PROFILE=production
PORT=3001
# If you use custom public ports (e.g. 13001), set PORT here and matching TOUR_OPS_API_URL in web.env.
STORAGE_DRIVER=prisma

# Postgres on VPS (native :5433 — NOT local dev Docker :5434)
# Production database name MUST be tour_db_prod (dev uses tour_db on :5434 locally).
# After editing passwords, verify: bash scripts/vps-deploy/verify-db-env.sh /etc/app-tour/api.env
# On mismatch, remote-deploy auto-runs sync-db-app-role-password.sh (requires DATABASE_URL_ADMIN)
DATABASE_URL=postgresql://app_tour:CHANGE_ME@127.0.0.1:5433/tour_db_prod?connection_limit=32
DATABASE_URL_ADMIN=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/tour_db_prod?connection_limit=8

# Production Redis logical DB 1 (dev Docker uses db 0 on same port locally)
REDIS_URL=redis://127.0.0.1:6379/1
TENANT_RATE_LIMIT_ENABLED=true
OUTBOX_RELAY_ENABLED=false

# MinIO on VPS
MINIO_ENDPOINT=http://127.0.0.1:9002
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=app-tour-prod

# RS256 JWT — generate: cd apps/api && pnpm run bootstrap:dev-jwt
AUTH_JWT_ISSUER=tour-ops
AUTH_JWT_AUDIENCE=tour-ops-api
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional dev OTP until SMS (remove in real production)
# AUTH_ALLOW_DEV_STATIC_OTP=true
# OPERATOR_OWNER_MOBILE=+989121000001

# Raw IP / loopback staging (no DNS subdomain yet) — maps bare host → workspace label
# PUBLIC_TENANT_FALLBACK_LABEL=denali
# PUBLIC_TENANT_FALLBACK_HOSTS=89.45.89.206,127.0.0.1
